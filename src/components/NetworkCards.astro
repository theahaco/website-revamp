---
// Network cards, logo first: the home "Networks" section and the cards at the
// bottom of /networks. A card links to the network's page only when it has
// one (`href`); the others are plain cards, without an arrow. `desc` is HTML
// (the /networks cards carry an inline link), so it must be trusted text.
interface Item {
  id: string;
  name: string;
  logo: string;
  desc: string;
  href?: string;
  cta?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
// Each mark at the height that gives the four the same visual weight, with
// its intrinsic aspect ratio (width / height) so the space is kept while it loads.
const marks: Record<string, { h: number; ratio: number }> = {
  stellar: { h: 30, ratio: 106 / 26 },
  xrpl: { h: 34, ratio: 313 / 80 },
  canton: { h: 30, ratio: 1432 / 369 },
  ethereum: { h: 34, ratio: 320 / 80 },
};
const size = (id: string) => {
  const m = marks[id] ?? { h: 30, ratio: 4 };
  return { h: m.h, w: Math.round(m.h * m.ratio) };
};
---
<ul class="nwc" role="list">
  {items.map((n) => {
    const Card = n.href ? 'a' : 'div';
    return (
      <li class="nwc_item">
        <Card class:list={['nwc_card', !n.href && 'nwc_card--static']} href={n.href}>
          <div class="nwc_tile">
            <img class="nwc_logo" src={n.logo} alt="" width={size(n.id).w} height={size(n.id).h} style={`--h:${size(n.id).h}px`} loading="lazy" decoding="async" />
            {n.href && <span aria-hidden="true" class="nwc_go">↗</span>}
          </div>
          <div class="nwc_body">
            <h3 class="nwc_name">{n.name}</h3>
            <p class="nwc_desc" set:html={n.desc} />
            {n.href && n.cta && <span class="nwc_link">{n.cta} <span aria-hidden="true">→</span></span>}
          </div>
        </Card>
      </li>
    );
  })}
</ul>

<style>
  /* One frame, the cards sharing 1 px rules (as the other grids of the page) */
  .nwc { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; width: 100%; margin: 0; padding: 0; list-style: none; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .nwc_item { display: flex; min-width: 0; }
  .nwc_card { display: flex; flex-direction: column; width: 100%; background: var(--white); color: var(--ink); text-decoration: none; transition: background-color .2s; }
  a.nwc_card:hover { background: var(--paper); }
  a.nwc_card:focus-visible { outline-offset: -3px; }
  .nwc_card--static { cursor: default; }
  .nwc_tile { position: relative; display: grid; place-items: center; height: 96px; padding: 0 24px; border-bottom: 1px solid var(--line); background: var(--tint-paper); }
  .nwc_logo { display: block; width: auto; max-width: 100%; height: var(--h, 30px); }
  .nwc_go { position: absolute; top: 14px; right: 14px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--white); color: var(--deep-blue); font-size: 15px; line-height: 1; opacity: 0; transform: translate(-3px, 3px); transition: opacity .2s, transform .2s; }
  a.nwc_card:hover .nwc_go, a.nwc_card:focus-visible .nwc_go { opacity: 1; transform: none; }
  .nwc_body { display: flex; flex: 1; flex-direction: column; gap: 10px; padding: 24px 24px 26px; }
  .nwc_name { margin: 0; font-family: var(--font-display); font-size: 26px; font-style: italic; font-weight: 400; line-height: 1.2; color: var(--deep-blue); transition: color .2s; }
  .nwc_desc { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
  .nwc_desc :global(a) { position: relative; z-index: 1; color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .nwc_desc :global(a:hover) { color: var(--green-ink); }
  .nwc_link { margin-top: auto; padding-top: 10px; font-size: 14px; font-weight: 600; color: var(--deep-blue); transition: color .2s; }
  a.nwc_card:hover .nwc_name, a.nwc_card:hover .nwc_link { color: var(--green-ink); }
  @media (prefers-reduced-motion: reduce) {
    .nwc_go { transform: none; transition: none; }
  }
  @media (max-width: 991px) {
    .nwc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Phones: one card per row, the logo tile on the left */
  @media (max-width: 599px) {
    .nwc { grid-template-columns: minmax(0, 1fr); }
    .nwc_card { flex-direction: row; }
    .nwc_tile { flex: 0 0 120px; height: auto; min-height: 104px; padding: 0 12px; border-right: 1px solid var(--line); border-bottom: 0; }
    .nwc_logo { height: calc(var(--h, 30px) * .8); }
    .nwc_go { display: none; }
    .nwc_body { gap: 6px; padding: 16px 18px 18px; }
    .nwc_name { font-size: 22px; }
  }
</style>
