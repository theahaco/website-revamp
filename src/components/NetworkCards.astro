---
// Network cards as the site's tiles (the tool tiles of /open-source): white,
// a 1 px line, 16 px corners, the network's symbol in an icon box first, then
// the name, the line, and a ruled foot with the next step. A tile links to
// the network's page only when it has one (`href`), with the arrow in its
// corner; the others are plain tiles, without an arrow, which can carry a
// status line and a link of their own (`link`, e.g. to /contact). `desc` is
// HTML, so it must be trusted text. Used by /networks (and by the former home
// section, HomeNetworks.astro, which no page renders).
import NetMark from './home/NetMark.astro';

interface Item {
  id: string;
  name: string;
  /** The network's logo, drawn only for a network NetMark does not know. */
  logo: string;
  desc: string;
  href?: string;
  cta?: string;
  status?: string;
  link?: { href: string; label: string };
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
const nets = ['stellar', 'xrpl', 'canton', 'ethereum'] as const;
type Net = (typeof nets)[number];
const isNet = (id: string): id is Net => (nets as readonly string[]).includes(id);
---
<ul class="nwc" role="list">
  {items.map((n) => {
    const Tile = n.href ? 'a' : 'div';
    return (
      <li class="nwc_item">
        <Tile class:list={['nwc_tile', !n.href && 'nwc_tile--static']} href={n.href}>
          <span class="nwc_top">
            <span class="v-iconbox nwc_icon">{isNet(n.id) ? <NetMark net={n.id} size={24} lazy /> : <img alt="" class="nwc_logo" height="24" loading="lazy" src={n.logo} />}</span>
            {n.href && <span aria-hidden="true" class="nwc_arrow">↗</span>}
          </span>
          <h3 class="nwc_name">{n.name}</h3>
          <div class="nwc_body">
            <p class="nwc_desc" set:html={n.desc} />
            {n.status && <p class="nwc_status">{n.status}</p>}
          </div>
          <div class="nwc_foot">
            {n.href && n.cta && <span class="nwc_link">{n.cta} <span aria-hidden="true">→</span></span>}
            {!n.href && n.link && <a class="nwc_link" href={n.link.href}>{n.link.label}&nbsp;<span aria-hidden="true">→</span></a>}
          </div>
        </Tile>
      </li>
    );
  })}
</ul>

<style>
  /* Four across; the tiles share their rows (subgrid), so names, lines and
     feet line up */
  .nwc { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; width: 100%; margin: 0; padding: 0; list-style: none; }
  .nwc_item { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; min-width: 0; }
  .nwc_tile { position: relative; display: grid; grid-row: 1 / span 4; grid-template-rows: subgrid; row-gap: 0; min-width: 0; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--white); color: var(--ink); text-decoration: none; transition: border-color .2s, box-shadow .2s; }
  a.nwc_tile:hover { border-color: var(--line-strong); box-shadow: var(--shadow-1); }
  a.nwc_tile:focus-visible { outline: 2px solid var(--green-ink); outline-offset: 2px; }
  .nwc_tile--static { cursor: default; }
  .nwc_top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .nwc_logo { display: block; width: auto; max-width: 36px; height: 24px; object-fit: cover; object-position: left center; }
  .nwc_arrow { color: var(--muted-2); font-size: 18px; line-height: 1; transition: color .2s, transform .2s; }
  a.nwc_tile:hover .nwc_arrow { color: var(--green-ink); transform: translate(2px, -2px); }
  .nwc_name { margin: 0 0 8px; color: var(--deep-blue); font-family: var(--font-display); font-size: 26px; font-style: italic; font-weight: 400; line-height: 1.15; }
  .nwc_body { display: flex; flex-direction: column; gap: 10px; padding-bottom: 20px; }
  .nwc_desc { margin: 0; color: var(--ink-2); font-size: 15px; line-height: 1.55; text-wrap: pretty; }
  .nwc_desc :global(a) { position: relative; z-index: 1; color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .nwc_desc :global(a:hover) { color: var(--green-ink); }
  /* A tile without a page: its status under the line */
  .nwc_status { margin: 0; color: var(--muted); font-size: 13px; font-weight: 500; line-height: 1.4; }
  .nwc_foot { display: flex; align-items: center; padding-top: 16px; border-top: 1px solid var(--line); }
  .nwc_link { color: var(--deep-blue); font-size: 15px; font-weight: 600; line-height: 1.4; text-decoration: none; transition: color .2s; }
  a.nwc_tile:hover .nwc_link, a.nwc_link:hover { color: var(--green-ink); }
  @media (pointer: coarse) { a.nwc_link { display: inline-flex; align-items: center; min-height: 44px; } .nwc_foot { padding-top: 6px; } }
  @media (prefers-reduced-motion: reduce) {
    .nwc_tile, .nwc_arrow { transition: none; }
    a.nwc_tile:hover .nwc_arrow { transform: none; }
  }
  @media (max-width: 1199px) {
    .nwc { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Phones: one tile per row, the icon box beside the name (as the tool tiles) */
  @media (max-width: 599px) {
    .nwc { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .nwc_item { display: block; grid-row: auto; }
    .nwc_tile { grid-template-columns: 40px minmax(0, 1fr); grid-template-rows: auto; column-gap: 14px; padding: 18px 18px 16px 16px; }
    .nwc_top { display: contents; }
    .nwc_icon { grid-column: 1; grid-row: 1; width: 40px; height: 40px; border-radius: 10px; }
    .nwc_icon :global(.netmark) { transform: scale(.84); }
    .nwc_arrow { position: absolute; top: 16px; right: 16px; font-size: 16px; }
    .nwc_name { grid-column: 2; grid-row: 1; align-self: center; margin: 0; padding-right: 24px; font-size: 22px; }
    .nwc_body { grid-column: 1 / -1; gap: 8px; padding: 12px 0 16px; }
    .nwc_foot { grid-column: 1 / -1; padding-top: 12px; }
  }
</style>
