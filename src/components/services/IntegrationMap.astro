---
// /services, protocols and products: an integration surface mapped to the
// target network, drawn as product UI. Your protocol at the top, the three
// layers written for the network in the middle, the networks at the bottom
// (Stellar, XRPL, Canton or EVM, with their marks).
// Generic: every label comes from the door's offer and lede on /services.
import Icon from '../Icon.astro';
import NetMark from '../home/NetMark.astro';
import Panel from './Panel.astro';

const parts = [
  { icon: 'code', title: 'Native contracts', sub: 'Written for the network, not ported' },
  { icon: 'package', title: 'Adapters and SDKs', sub: 'A typed client for your stack' },
  { icon: 'swap', title: 'Routing and liquidity', sub: 'Bridges, exchanges and liquidity plans' },
];
const nets = [
  { net: 'stellar', size: 15 },
  { net: 'xrpl', size: 14 },
  { net: 'canton', size: 16 },
  { net: 'ethereum', size: 17 },
] as const;
---
<Panel class="im" snug label="An integration: your protocol or product, with native contracts, adapters and SDKs, and routing and liquidity written for Stellar, XRPL, Canton or EVM" tint="green">
  <div class="im_map">
    <div class="im_node">
      <span class="im_tile"><Icon name="plugs-connected" size={24} /></span>
      <span class="im_text"><span class="im_title im_title--lg">Your protocol or product</span><span class="im_sub">Live elsewhere, or launching for the first time</span></span>
    </div>
    <span aria-hidden="true" class="im_fork"></span>
    <ul class="im_parts" role="list">
      {parts.map((p) => (
        <li class="im_part">
          <span class="im_icon"><Icon name={p.icon} size={20} /></span>
          <span class="im_title">{p.title}</span>
          <span class="im_sub">{p.sub}</span>
        </li>
      ))}
    </ul>
    <span aria-hidden="true" class="im_fork im_fork--merge"></span>
    <div class="im_node im_node--net">
      <span aria-hidden="true" class="im_marks">{nets.map((n) => <span class="im_mark"><NetMark net={n.net} size={n.size} lazy /></span>)}</span>
      <span class="im_text"><span class="im_title im_title--lg">On Stellar, XRPL, Canton or EVM</span><span class="im_sub">Matched to the guarantees you already give users</span></span>
    </div>
  </div>
</Panel>

<style>
  .im_map { --im-gap: 12px; --im-rail: rgba(26, 59, 96, .3); position: relative; z-index: 1; display: flex; flex-direction: column; width: 100%; max-width: 540px; margin: 0 auto; }
  .im_text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .im_title { color: var(--deep-blue); font-size: 15px; font-weight: 600; line-height: 1.25; text-wrap: balance; }
  .im_title--lg { font-size: 16px; }
  .im_sub { color: var(--muted); font-size: 14px; line-height: 1.35; }

  /* The two end cards */
  .im_node { display: flex; align-items: center; gap: 14px; align-self: center; width: min(100%, 420px); padding: 14px 16px 14px 14px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--white); box-shadow: var(--shadow-2); }
  .im_tile { display: grid; place-items: center; flex-shrink: 0; width: 52px; height: 48px; border-radius: 12px; background: var(--tint-green); color: var(--deep-blue); --icon-tint: var(--vibrant-green); --icon-tint-opacity: .55; }
  /* The networks' marks, overlapped like a stack of avatars */
  .im_marks { display: flex; flex-shrink: 0; }
  .im_mark { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--line-strong); border-radius: 50%; background: var(--white); box-shadow: 0 0 0 2px var(--white); }
  .im_mark + .im_mark { margin-left: -6px; }

  /* What we write for the network: three cards in a row */
  .im_parts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--im-gap); margin: 0; padding: 0; list-style: none; }
  .im_part { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; min-width: 0; padding: 14px 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--white); box-shadow: var(--shadow-1); }
  .im_icon { display: grid; place-items: center; width: 34px; height: 32px; margin-bottom: 8px; border-radius: 9px; background: var(--tint-green); color: var(--deep-blue); --icon-tint: var(--vibrant-green); --icon-tint-opacity: .55; }

  /* Dashed fork from the top card to the three parts, and merge into the
     network card; the drops land on the centre of each part */
  .im_fork { position: relative; display: block; height: 40px; }
  .im_fork::before { content: ''; position: absolute; left: 50%; top: 0; height: 50%; border-left: 2px dashed var(--im-rail); }
  .im_fork::after { content: ''; position: absolute; top: calc(50% - 1px); left: calc((100% - 2 * var(--im-gap)) / 6); right: calc((100% - 2 * var(--im-gap)) / 6); border-top: 2px dashed var(--im-rail); }
  .im_fork--merge::before { top: 50%; }
  .im_part::before, .im_part::after { content: ''; position: absolute; left: calc(50% - 1px); height: 19px; border-left: 2px dashed var(--im-rail); }
  .im_part::before { top: -21px; }
  .im_part::after { bottom: -21px; }

  @container (max-width: 470px) {
    .im_part { padding: 12px 12px 14px; }
    .im_title { font-size: 14.5px; }
    .im_sub { font-size: 13.5px; }
  }
  /* Narrow panels: the parts stacked, one dashed rail through them */
  @container (max-width: 400px) {
    .im_parts { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .im_part { display: grid; grid-template-columns: 34px minmax(0, 1fr); column-gap: 12px; row-gap: 2px; align-items: center; padding: 12px; }
    .im_icon { grid-row: 1 / span 2; margin: 0; }
    .im_title { font-size: 15px; }
    .im_sub { font-size: 14px; }
    .im_part::before { top: -12px; height: 10px; }
    .im_part::after { bottom: -12px; height: 10px; }
    .im_fork { height: 28px; }
    .im_fork::before { height: 100%; }
    .im_fork::after { display: none; }
    .im_title--lg { font-size: 15px; }
    .im_node { gap: 12px; padding: 12px 14px 12px 12px; }
    .im_tile { width: 44px; height: 42px; }
    .im_mark { width: 28px; height: 28px; }
    /* The marks over the network names, so the text keeps its width */
    .im_node--net { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>
