---
// /services, financial institutions: the life of a regulated asset, from a
// named engagement. EURCV, Société Générale-FORGE's euro stablecoin, as its
// case study tells it (src/content/case-studies/societe-generale-forge.md):
// launch governance on Soroban, audited by Hacken; then compliance on
// Stellar's built-in issuer controls, operated by the SG-FORGE compliance
// team; the same native Stellar asset throughout. Drawn as product UI, with
// no amounts. (The home page's institutions row draws the bank's settlement
// stablecoin; this is other material.) The case study shows it too, after its
// Solution (src/lib/caseVisuals.ts, bodyVisuals), without the caption: that
// section ends on the same sentence, and the link would point at the page itself.
import Icon from '../Icon.astro';
import Panel from './Panel.astro';
import { nobr } from '../../lib/content';

interface Props {
  /** The line under the panel, with its link to the case study (default: shown). */
  caption?: boolean;
}
const { caption = true } = Astro.props;
const CASE = '/case-studies/societe-generale-forge';
const stages = [
  {
    when: 'At launch',
    title: 'Governance on Soroban',
    lines: ['Issuer, compliance and pause roles', 'A denylist and pausable transfers'],
    note: { icon: 'shield-check', text: 'Audited by Hacken before mainnet' },
  },
  {
    when: 'Now',
    title: 'Stellar’s built-in issuer controls',
    lines: ['A flagged address is frozen', 'No contract in the transfer path'],
    note: { icon: 'users-three', text: 'Operated by the SG-FORGE compliance team' },
  },
];
---
<div class="ec">
  <Panel class="ec_panel" label="EURCV, Société Générale-FORGE’s regulated euro stablecoin on Stellar: governance on Soroban at launch, audited by Hacken, then compliance on Stellar’s built-in issuer controls" snug tint="blue">
    <div class="ec_body">
      <div class="ec_asset">
        <span class="ec_tile"><img alt="" decoding="async" height="17" loading="lazy" src="/images/logos/logo-light-sgforge.svg" width="60" /></span>
        <span class="ec_text"><span class="ec_title">EURCV</span><span class="ec_sub">Regulated euro stablecoin, a native Stellar asset</span></span>
        <span class="ec_status"><span aria-hidden="true" class="v-live"></span>Live since Q1 2026</span>
      </div>
      <ol class="ec_stages" role="list">
        {stages.map((s, i) => (
          <li class:list={['ec_stage', i === stages.length - 1 && 'ec_stage--now']}>
            <span aria-hidden="true" class="ec_node"></span>
            <p class="ec_when">{s.when}</p>
            <div class="ec_card">
              <p class="ec_stitle">{s.title}</p>
              <ul class="ec_lines" role="list">
                {s.lines.map((l) => (
                  <li class="ec_line"><span aria-hidden="true" class="ec_check"><svg fill="none" height="11" viewBox="0 0 14 14" width="11"><path d="M2.5 7.4 5.6 10.3 11.5 3.9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" /></svg></span>{l}</li>
                ))}
              </ul>
              <p class="ec_note"><Icon name={s.note.icon} size={16} /><span set:html={nobr(s.note.text)} /></p>
            </div>
          </li>
        ))}
      </ol>
      <p class="ec_float"><span aria-hidden="true" class="ec_floaticon"><Icon name="list-magnifying-glass" size={17} /></span><span>Every privileged action visible on the public ledger</span></p>
    </div>
  </Panel>
  {caption && <p class="ec_caption">EURCV stayed the same native Stellar asset throughout (<a class="ec_link" href={CASE}>case study</a>).</p>}
</div>

<style>
  .ec { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .ec :global(.ec_panel) { flex: 1 1 auto; }
  .ec_body { --ec-rail: rgba(26, 59, 96, .3); position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 560px; }

  /* The asset, across both stages */
  .ec_asset { position: relative; display: flex; align-items: center; gap: 14px; width: 100%; padding: 14px 16px 14px 14px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--white); box-shadow: var(--shadow-2); }
  .ec_tile { display: grid; place-items: center; flex-shrink: 0; width: 76px; height: 52px; border-radius: 12px; background: var(--tint-blue); }
  .ec_tile img { display: block; width: 60px; height: auto; }
  .ec_text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .ec_title { color: var(--deep-blue); font-size: 17px; font-weight: 600; line-height: 1.25; }
  .ec_sub { color: var(--muted); font-size: 14px; line-height: 1.35; }
  .ec_status { display: inline-flex; align-items: center; gap: 7px; flex-shrink: 0; height: 26px; margin-left: auto; padding: 0 11px 0 10px; border-radius: 999px; background: var(--tint-green); color: #2f6e10; font-size: 12px; font-weight: 600; line-height: 1; white-space: nowrap; }
  .ec_status .v-live { width: 7px; height: 7px; }

  /* Two stages on a timeline: a node, its label, its card; each node hangs
     from the asset on a dashed drop, and a line runs from the first node to
     the second */
  .ec_stages { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; width: 100%; margin: 0; padding: 28px 0 0; list-style: none; }
  .ec_stage { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto 1fr; row-gap: 10px; min-width: 0; }
  .ec_stage::before { content: ''; position: absolute; top: -28px; left: 6px; height: 28px; border-left: 2px dashed var(--ec-rail); }
  .ec_node { position: relative; z-index: 1; justify-self: start; width: 14px; height: 14px; border: 2px solid var(--deep-blue); border-radius: 50%; background: var(--white); }
  .ec_stage--now .ec_node { border-color: var(--vibrant-green); background: var(--vibrant-green); box-shadow: 0 0 0 3px var(--tint-blue); }
  .ec_stage:first-child::after { content: ''; position: absolute; top: 6px; left: 14px; right: -16px; border-top: 2px solid var(--line-strong); }
  .ec_when { margin: 0; color: var(--deep-blue); font-size: 12.5px; font-weight: 600; line-height: 1.2; letter-spacing: .08em; text-transform: uppercase; }

  .ec_card { display: flex; flex: 1 1 auto; flex-direction: column; min-width: 0; padding: 16px 16px 0; border: 1px solid var(--line-strong); border-radius: 14px; background: var(--white); box-shadow: var(--shadow-1); }
  .ec_stitle { margin: 0 0 12px; color: var(--deep-blue); font-size: 16px; font-weight: 600; line-height: 1.3; }
  .ec_lines { display: flex; flex-direction: column; gap: 9px; margin: 0 0 16px; padding: 0; list-style: none; }
  .ec_line { display: flex; align-items: flex-start; gap: 10px; color: var(--ink); font-size: 14.5px; font-weight: 500; line-height: 1.35; }
  .ec_check { display: grid; place-items: center; flex-shrink: 0; width: 18px; height: 18px; margin-top: 0; border-radius: 50%; background: var(--vibrant-green); color: var(--white); }
  .ec_note { display: flex; align-items: flex-start; gap: 8px; margin: auto -16px 0; padding: 11px 16px 12px; border-top: 1px solid var(--line); border-radius: 0 0 13px 13px; background: var(--paper); color: var(--ink-2); font-size: 13.5px; font-weight: 500; line-height: 1.35; --icon-tint: var(--vibrant-green); --icon-tint-opacity: .5; }
  .ec_note :global(.icon) { margin-top: 1px; color: var(--deep-blue); }

  /* The fact that holds across both stages, as a pill under them */
  .ec_float { display: inline-flex; align-items: center; gap: 8px; max-width: 100%; margin: 22px 0 0; padding: 8px 14px 8px 9px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--white); box-shadow: var(--shadow-2); color: var(--deep-blue); font-size: 13px; font-weight: 600; line-height: 1.25; }
  .ec_floaticon { display: inline-grid; place-items: center; flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--tint-green); color: var(--deep-blue); --icon-tint: var(--vibrant-green); --icon-tint-opacity: .6; }

  .ec_caption { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
  .ec_link { color: var(--deep-blue); font-weight: 600; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .ec_link:hover { color: var(--green-ink); }
  @media (pointer: coarse) { .ec_link { display: inline-block; padding: 12px 0; margin: -12px 0; } }

  /* Mid-width panels: the status under the name */
  @container (max-width: 500px) {
    .ec_asset { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 14px; row-gap: 8px; }
    .ec_tile { grid-row: 1 / span 2; }
    .ec_status { justify-self: start; margin-left: 0; }
  }
  /* Narrow panels: the stages one under the other, on a rail down the left */
  @container (max-width: 420px) {
    .ec_asset { column-gap: 12px; padding: 12px; }
    .ec_tile { width: 60px; height: 46px; }
    .ec_tile img { width: 48px; }
    .ec_stages { grid-template-columns: minmax(0, 1fr); gap: 22px; padding-top: 24px; }
    .ec_stage { grid-template-columns: 14px minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: 12px; }
    .ec_node { grid-column: 1; grid-row: 1; align-self: center; }
    .ec_when { grid-column: 2; grid-row: 1; }
    .ec_card { grid-column: 2; grid-row: 2; }
    .ec_stage::before { top: -24px; height: 24px; }
    .ec_stage--now::before { display: none; }
    .ec_stage:first-child::after { top: 14px; bottom: -22px; left: 6px; right: auto; border-top: 0; border-left: 2px solid var(--line-strong); }
    .ec_float { margin-top: 18px; }
  }
</style>
