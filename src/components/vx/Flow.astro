---
// A process drawn as product UI: white cards on a tinted panel, joined by a
// dashed rail. Anchor cards open and close the flow (an icon or a logo in a
// tinted tile, a title, a line, an optional live status); check chips sit on
// the rail between them. Optional floating facts sit over the panel edges.
//
// Only real things go in here: steps that describe what the service does
// (generic) or what a named engagement did (from its case study). No sample
// amounts, no invented figures.
import Icon from '../Icon.astro';
import NetMark from '../home/NetMark.astro';

export interface FlowStep {
  kind: 'anchor' | 'check';
  title: string;
  sub?: string;
  /** Anchor tile: an icon from src/icons... */
  icon?: string;
  /** ...or a logo (drawn at w x h px)... */
  logo?: { src: string; w: number; h: number };
  /** ...or a network's symbol. */
  net?: 'stellar' | 'xrpl' | 'canton' | 'ethereum';
  tone?: 'blue' | 'green' | 'pink' | 'tan';
  /** A green status pill on the anchor card, e.g. "Live". */
  status?: string;
}
export interface FlowFloat { text: string; icon?: string; at: 'top' | 'bottom' }

interface Props {
  /** What the flow shows, for screen readers. */
  label: string;
  steps: FlowStep[];
  floats?: FlowFloat[];
  /** Panel tint. */
  panel?: 'paper' | 'blue' | 'pink' | 'tan' | 'green';
  /** A system not live yet (in design or in build): its checks are drawn
      hollow, so they read as the design, not as something already running. */
  planned?: boolean;
  /** Id of a caption that describes the flow. */
  describedby?: string;
  class?: string;
}
const { label, steps, floats = [], panel = 'paper', planned = false, describedby, class: cls } = Astro.props;
---
<figure aria-describedby={describedby} aria-label={label} class:list={['vf', `vf--${panel}`, planned && 'vf--planned', cls]}>
  <div aria-hidden="true" class="vf_grid"></div>
  <ol class="vf_steps" role="list">
    {steps.map((s) => s.kind === 'anchor' ? (
      <li class="vf_step vf_anchor">
        <span class:list={['vf_tile', `vf_tile--${s.tone ?? 'blue'}`]}>
          {s.net ? <NetMark net={s.net} size={24} lazy /> : s.logo ? <img alt="" height={s.logo.h} src={s.logo.src} width={s.logo.w} loading="lazy" decoding="async" /> : <Icon name={s.icon ?? 'cube'} size={26} />}
        </span>
        <span class="vf_text">
          <span class="vf_title">{s.title}</span>
          {s.sub && <span class="vf_sub">{s.sub}</span>}
        </span>
        {s.status && <span class="vf_status"><span aria-hidden="true" class="v-live"></span>{s.status}</span>}
      </li>
    ) : (
      <li class="vf_step vf_check">
        <span aria-hidden="true" class="vf_mark"><svg fill="none" height="14" viewBox="0 0 14 14" width="14"><path d="M2.5 7.4 5.6 10.3 11.5 3.9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg></span>
        <span class="vf_text">
          <span class="vf_title">{s.title}</span>
          {s.sub && <span class="vf_sub">{s.sub}</span>}
        </span>
      </li>
    ))}
  </ol>
  {floats.map((f) => (
    <p class:list={['vf_float', `vf_float--${f.at}`]}><span aria-hidden="true" class="vf_floaticon"><Icon name={f.icon ?? 'shield-check'} size={18} /></span><span>{f.text}</span></p>
  ))}
</figure>

<style>
  /* Panel: a tinted rounded field with a faint blueprint grid in its middle */
  .vf { position: relative; display: grid; place-items: center; margin: 0; padding: 56px 40px; border: 1px solid var(--line); border-radius: 20px; background: var(--tint-paper); container-type: inline-size; }
  .vf--blue { background: var(--tint-blue); }
  .vf--pink { background: var(--tint-pink); }
  .vf--tan { background: var(--tint-tan); }
  .vf--green { background: var(--tint-green); }
  .vf_grid { position: absolute; inset: 0; border-radius: inherit; background-image: linear-gradient(rgba(26, 59, 96, .07) 1px, transparent 1px), linear-gradient(90deg, rgba(26, 59, 96, .07) 1px, transparent 1px); background-size: 32px 32px; background-position: center; -webkit-mask-image: radial-gradient(closest-side, #000 30%, transparent); mask-image: radial-gradient(closest-side, #000 30%, transparent); pointer-events: none; }

  /* The steps, on a dashed rail that runs through the anchor tiles */
  .vf_steps { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 14px; width: 100%; max-width: 420px; margin: 0; padding: 0; list-style: none; }
  .vf_steps::before { content: ''; position: absolute; left: 41px; top: 40px; bottom: 40px; border-left: 2px dashed rgba(26, 59, 96, .28); }
  .vf_step { position: relative; display: flex; align-items: center; gap: 14px; min-width: 0; }
  .vf_text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .vf_title { color: var(--deep-blue); font-size: 15px; font-weight: 600; line-height: 1.3; }
  .vf_sub { color: var(--muted); font-size: 14px; line-height: 1.35; }

  .vf_anchor { padding: 14px 16px 14px 14px; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--white); box-shadow: var(--shadow-2); }
  .vf_tile { display: grid; place-items: center; flex-shrink: 0; width: 56px; height: 52px; border-radius: 12px; background: var(--tint-blue); color: var(--deep-blue); --icon-tint: var(--vibrant-green); --icon-tint-opacity: .55; }
  .vf_tile--green { background: var(--tint-green); }
  .vf_tile--pink { background: var(--tint-pink); }
  .vf_tile--tan { background: var(--tint-tan); }
  .vf_tile img { display: block; max-width: 58px; height: auto; }
  .vf_tile:has(img:not(.netmark)) { width: 72px; }
  .vf_anchor .vf_title { font-size: 16px; }
  .vf_status { display: inline-flex; align-items: center; gap: 7px; flex-shrink: 0; height: 26px; margin-left: auto; padding: 0 11px 0 10px; border-radius: 999px; background: var(--tint-green); color: #2f6e10; font-size: 12px; font-weight: 600; line-height: 1; white-space: nowrap; }
  .vf_status .v-live { width: 7px; height: 7px; }

  /* Check chips hang off the rail with a short dashed branch */
  .vf_check { margin-left: 76px; padding: 11px 16px 11px 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--white); box-shadow: var(--shadow-1); }
  .vf_check::before { content: ''; position: absolute; top: 50%; left: -35px; width: 34px; border-top: 2px dashed rgba(26, 59, 96, .28); }
  .vf_check::after { content: ''; position: absolute; top: calc(50% - 4px); left: -40px; width: 8px; height: 8px; border-radius: 50%; background: var(--deep-blue); box-shadow: 0 0 0 3px var(--white); }
  .vf_mark { display: grid; place-items: center; flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--vibrant-green); color: var(--white); }
  .vf_check .vf_title { font-weight: 500; color: var(--ink); }
  /* Not live yet: a hollow mark, the step is designed, not running */
  .vf--planned .vf_mark { background: none; box-shadow: inset 0 0 0 2px var(--green-ink); color: var(--green-ink); }

  /* Floating facts over the panel edges */
  .vf_float { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: 8px; max-width: calc(100% - 32px); margin: 0; padding: 8px 14px 8px 9px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--white); box-shadow: var(--shadow-2); color: var(--deep-blue); font-size: 13px; font-weight: 600; line-height: 1.25; }
  .vf_floaticon { display: inline-grid; place-items: center; flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; background: var(--tint-green); color: var(--deep-blue); --icon-tint: var(--vibrant-green); --icon-tint-opacity: .6; }
  .vf_float--top { top: -18px; right: 24px; }
  .vf_float--bottom { bottom: -18px; left: 24px; }

  @container (max-width: 420px) {
    .vf_steps::before { left: 33px; }
    .vf_anchor { padding: 12px 12px 12px 10px; gap: 12px; }
    .vf_tile { width: 48px; height: 44px; border-radius: 10px; }
    .vf_tile :global(svg) { width: 22px; height: 22px; }
    .vf_tile img { max-width: 52px; }
    .vf_check { margin-left: 60px; padding: 10px 12px 10px 10px; gap: 10px; }
    .vf_check::before { left: -27px; width: 26px; }
    .vf_check::after { left: -31px; }
    .vf_status { position: absolute; top: -12px; right: 10px; }
  }
  @media (max-width: 767px) {
    .vf { padding: 44px 20px; }
  }
  @media (max-width: 479px) {
    .vf { padding: 40px 12px; }
    .vf_check { margin-left: 46px; }
    .vf_check::before { left: -19px; width: 18px; }
    .vf_check::after { left: -23px; }
    .vf_steps::before { left: 25px; }
    .vf_anchor .vf_tile { width: 40px; height: 40px; }
  }
  @media (max-width: 767px) {
    .vf_float { font-size: 12px; padding: 6px 12px 6px 7px; }
    .vf_floaticon { width: 22px; height: 22px; }
    .vf_float--top { right: 12px; }
    .vf_float--bottom { left: 12px; }
  }
</style>
