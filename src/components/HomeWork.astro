---
// Home page "Selected work": the numbered case studies (each with its client's
// logo; their quotes are in the section under the hero, home/Logos.astro), the
// block of the clients not named ("More work for financial institutions") and
// the articles tab. Webflow tabs markup, driven by src/scripts/tabs.js. The
// block's icons come from src/lib/visuals.ts.
import { caseStudies, posts, pick, nobr, formatDate } from '../lib/content';
import { homeFeaturedCases, homeNdaCases, homeArticles } from '../data/curation';
import { caseVisual } from '../lib/visuals';
import { workVisuals } from '../lib/workVisuals';
import Icon from './Icon.astro';
import WorkVisual from './home/WorkVisual.astro';

const all = await caseStudies();
const featured = pick(all, homeFeaturedCases);
const nda = pick(all, homeNdaCases);
// The three most recent articles, unless curation.ts pins a selection.
const allPosts = await posts();
const articles = homeArticles.length ? pick(allPosts, homeArticles) : allPosts.slice(0, 3);
const iconbox = (tone: string) => ['v-iconbox', tone !== 'blue' && `v-iconbox--${tone}`];
---
<div class="work_tabs w-tabs" data-current="Tab 1" data-duration-in="300" data-duration-out="100" data-easing="ease">
  <div aria-label="Work type" class="work_toggle w-tab-menu">
    <a class="work_toggle-btn w-inline-block w-tab-link w--current" data-w-tab="Tab 1" href="#work-cases">Case studies</a>
    {articles.length > 0 && <a class="work_toggle-btn w-inline-block w-tab-link" data-w-tab="Tab 2" href="#work-articles">Articles</a>}
  </div>
  <div class="work_panels w-tab-content">
    <div class="w-tab-pane w--tab-active" data-w-tab="Tab 1" id="work-cases">
      <div class="w-dyn-list">
        <ul class="hw_grid" role="list">
          {featured.map((cs) => {
            // One tile per case: its visual on top (a different kind per case,
            // src/lib/workVisuals.ts), then what was built, the line and the
            // client once, as a byline. The text comes first in the markup, so
            // a screen reader meets the title before the picture.
            const visual = workVisuals[cs.id];
            return (
              <li class="hw_tile" data-client={cs.id}>
                <div class="hw_body">
                  {cs.data.eyebrow && <p class="hw_eyebrow">{cs.data.eyebrow}</p>}
                  <h3 class="hw_title"><a class="hw_tlink" href={`/case-studies/${cs.id}`}><span set:html={nobr(cs.data.workTitle || cs.data.title)} /><span class="hw_sr">: {cs.data.client || cs.data.title} case study</span></a></h3>
                  {(cs.data.workLine || cs.data.lede) && <p class="hw_line" set:html={nobr(cs.data.workLine || cs.data.lede)} />}
                  <p class="hw_by"><span class="hw_client" set:html={nobr(cs.data.client || cs.data.title)} />{cs.data.year && <span class="hw_year">{cs.data.year}</span>}<span aria-hidden="true" class="hw_arrow">↗</span></p>
                </div>
                {visual && <div class="hw_visual"><WorkVisual visual={visual} /></div>}
              </li>
            );
          })}
        </ul>
      </div>
      {nda.length > 0 && (
        <div aria-labelledby="hw-more" class="hw_nda" role="group">
          <p class="hw_nda-label" id="hw-more">More work for financial institutions</p>
          <div class="w-dyn-list">
            <div class="hw_nda-list w-dyn-items" role="list">
              {nda.map((cs) => {
                const v = caseVisual(cs.id, cs.data);
                return (
                <div class="hw_nda-item w-dyn-item" role="listitem">
                  <a class="hw_nda-link" data-nda-link="1" href={`/case-studies/${cs.id}`}>
                    <span class:list={iconbox(v.tone)}><Icon name={v.icon} size={28} /></span>
                    <span class="hw_nda-text">
                      <span class="hw_nda-eyebrow">Client not named{cs.data.network && ` · ${cs.data.network}`}</span>
                      {cs.data.ndaSummary && <span class="hw_nda-body">{cs.data.ndaSummary}</span>}
                    </span>
                    <span aria-hidden="true" class="hw_nda-arrow">↗</span>
                  </a>
                </div>
              ); })}
            </div>
          </div>
        </div>
      )}
    </div>
    <div class="w-tab-pane" data-w-tab="Tab 2" id="work-articles">
      <div class="w-dyn-list">
        <div class="work_list w-dyn-items" role="list">
          {articles.map((post) => (
            <div class="work_item w-dyn-item" role="listitem">
              <a class="work_article-link w-inline-block hw_link hw_link--article" href={`/blog/${post.id}`}>
                <div class="work_num hw_num"></div>
                <div class="work_stack">
                  <div class="work_meta">
                    {post.data.category && <p class="work_eyebrow">{post.data.category}</p>}
                    <div class="work_yeararrow">
                      {post.data.date && <div>{formatDate(post.data.date, 'short')}</div>}
                      <div aria-hidden="true" class="work_arrow">↗</div>
                    </div>
                  </div>
                  <h3 class="work_article-h3" set:html={nobr(post.data.title)} />
                  {post.data.lede && <p class="work_para">{post.data.lede}</p>}
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <a class="btn-secondary work_all" href="/work">See all work →</a>
</div>

<style>
  /* Case tiles, two across: the visual on top, the text under it. The two
     tiles of a row share their rows (subgrid), so visuals and texts line up. */
  .hw_grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }
  .hw_tile { position: relative; display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 0; min-width: 0; padding: 8px; border: 1px solid var(--line); border-radius: 20px; background: var(--white); transition: border-color .2s, box-shadow .2s; }
  .hw_tile:hover { border-color: var(--line-strong); box-shadow: var(--shadow-1); }
  .hw_visual { grid-row: 1; min-width: 0; }
  .hw_body { grid-row: 2; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; min-width: 0; padding: 24px 20px 18px; }
  .hw_eyebrow { margin: 0; color: var(--green-ink); font-size: 12px; font-weight: 600; letter-spacing: .08em; line-height: 1.4; text-transform: uppercase; }
  .hw_title { margin: 0; color: var(--deep-blue); font-family: var(--font-display); font-size: 28px; font-style: italic; font-weight: 400; line-height: 1.15; letter-spacing: -.005em; text-wrap: balance; }
  .hw_tlink { color: inherit; text-decoration: none; }
  .hw_tlink::after { content: ''; position: absolute; inset: 0; z-index: 2; border-radius: 20px; }
  .hw_tlink:focus-visible { outline: none; }
  .hw_tile:has(.hw_tlink:focus-visible) { box-shadow: inset 0 0 0 2px var(--green-ink); }
  .hw_sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  .hw_line { margin: 0; color: var(--ink-2); font-size: 16px; line-height: 1.55; text-wrap: pretty; }
  .hw_by { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; width: 100%; margin: auto 0 0; padding-top: 8px; font-size: 14px; line-height: 1.4; }
  .hw_client { color: var(--deep-blue); font-weight: 600; }
  .hw_year { color: var(--muted); white-space: nowrap; }
  .hw_arrow { margin-left: auto; color: var(--deep-blue); font-size: 18px; line-height: 1; opacity: .5; transition: opacity .2s, transform .2s, color .2s; }
  .hw_tile:hover .hw_arrow { color: var(--green-ink); opacity: 1; }
  @media (prefers-reduced-motion: no-preference) { .hw_tile:hover .hw_arrow { transform: translate(2px, -2px); } }
  @media (prefers-reduced-motion: reduce) { .hw_tile, .hw_arrow { transition: none; } }
  a.hw_link:hover .work_article-h3 { color: var(--green-ink); }
  .work_article-h3 { transition: color .2s; }

  @media (max-width: 991px) {
    .hw_title { font-size: 24px; }
    .hw_body { padding: 20px 16px 16px; }
  }
  @media (max-width: 767px) {
    .hw_grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .hw_tile { grid-row: auto; grid-template-rows: auto auto; }
  }

  /* More work for financial institutions (clients not named): three framed
     cells sharing their borders */
  .hw_nda { margin-top: 32px; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--white); overflow: hidden; }
  .hw_nda-label { display: flex; align-items: center; gap: 10px; margin: 0; padding: 16px 28px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 12px; font-weight: 600; letter-spacing: .08em; line-height: 1.4; text-transform: uppercase; --icon-tint: var(--vibrant-green); --icon-tint-opacity: .55; }
  .hw_nda-label :global(.icon) { color: var(--deep-blue); }
  .hw_nda-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .hw_nda-item + .hw_nda-item { border-left: 1px solid var(--line); }
  .hw_nda-link { position: relative; display: flex; flex-direction: column; gap: 16px; height: 100%; padding: 28px; color: inherit; text-decoration: none; transition: background-color .2s ease; }
  .hw_nda-link:hover { background: var(--tint-paper); }
  /* The box clips its corners: the focus ring goes inside the cell */
  .hw_nda-link:focus-visible { outline-offset: -4px; border-radius: 4px; }
  .hw_nda-text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .hw_nda-eyebrow { color: var(--muted); font-size: 12px; font-weight: 600; letter-spacing: .08em; line-height: 1.4; text-transform: uppercase; transition: color .2s; }
  .hw_nda-link:hover .hw_nda-eyebrow { color: var(--green-ink); }
  .hw_nda-body { color: var(--ink-2); font-size: 16px; line-height: 1.5; text-wrap: pretty; }
  .hw_nda-arrow { position: absolute; top: 24px; right: 24px; color: var(--deep-blue); font-size: 18px; line-height: 1; opacity: .45; transition: opacity .2s ease, transform .2s ease; }
  .hw_nda-link:hover .hw_nda-arrow { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) { .hw_nda-link:hover .hw_nda-arrow { transform: translate(2px, -2px); } }
  @media (max-width: 991px) {
    .hw_nda-list { grid-template-columns: minmax(0, 1fr); }
    .hw_nda-item + .hw_nda-item { border-left: 0; border-top: 1px solid var(--line); }
    .hw_nda-link { flex-direction: row; align-items: flex-start; gap: 20px; padding: 24px 56px 24px 28px; }
  }
  @media (max-width: 479px) {
    .hw_nda-label { padding: 14px 20px; }
    .hw_nda-link { flex-direction: row; gap: 16px; padding: 20px 44px 20px 20px; }
    .hw_nda-link :global(.v-iconbox) { width: 40px; height: 40px; border-radius: 10px; }
    .hw_nda-arrow { top: 20px; right: 18px; }
  }
</style>
