---
// Home page section under the hero: clients and partners, in their own words.
// The quotes are those of the case studies listed in src/data/curation.ts
// (homeQuotes), read from their files, one at a time: the first by default,
// the others when the reader picks their author below it. Nothing moves on
// its own. The switch is native radio buttons and CSS (:has), so it works
// with a keyboard and without JavaScript; the quotes share one grid cell, so
// the section keeps its height. Each quote's last sentence (or last clause)
// takes the soft tone, like the two-tone headlines. The rows of "Selected
// work" show their client's logo instead of the quote. Under the quotes, one
// framed tile per client; a tile links to the public case study of that same
// client, or else to the client's own website (`site`). The key figures are in the hero's
// "Live on mainnet" card (deployments, audits) and in the open-source band
// (projects).
import { caseStudies, publicQuote } from '../../lib/content';
import { homeQuotes } from '../../data/curation';
import { site } from '../../data/site';

const production = !Astro.site || Astro.site.origin === site.productionOrigin;
const all = await caseStudies();
// "First sentences. Last sentence." or "First clause, last clause."
const split = (text: string) => {
  const m = text.match(/^(.*[.!?])\s+(\S.*)$/s) || text.match(/^(.*,)\s+(\S.*)$/s);
  return m ? { lead: m[1], soft: m[2] } : { lead: text, soft: '' };
};
const voices = homeQuotes
  .map((id) => all.find((c) => c.id === id))
  .filter((c) => c !== undefined)
  .map((c) => ({ id: c.id, ...publicQuote(c.data.quote, production) }))
  .filter((q) => q.text && q.author)
  .map((q) => ({ ...q, ...split(q.text) }));

// h: logo height in px on desktop (per file, for an even optical weight);
// w: its width at that height (from the file's proportions).
const logos = [
  { name: 'Stellar Development Foundation', src: '/images/logos/logo-light-stellar.svg', h: 22, w: 90, href: '/case-studies/stellar-development-foundation' },
  { name: 'Société Générale-FORGE', src: '/images/logos/logo-light-sgforge.svg', h: 26, w: 90, href: '/case-studies/societe-generale-forge' },
  { name: 'Ripple', src: '/images/logos/logo-light-ripple.svg', h: 22, w: 85, href: '/case-studies/ripple' },
  // Talwex: symbol and wordmark as on talwex.com (Inter Bold, outlined).
  { name: 'Talwex', src: '/images/logos/logo-light-talwex.svg', h: 20, w: 101, site: 'https://www.talwex.com/' },
  { name: 'LI.FI', src: '/images/logos/logo-light-lifi.svg', h: 23, w: 63, href: '/case-studies/lifi' },
  { name: 'Banque Delubac et Cie', src: '/images/logos/logo-light-delubac.svg', h: 25, w: 111, site: 'https://www.delubac.com/' },
];
---
<section aria-labelledby="vc-label" class="vc" data-rv="logos">
  <div class="vc_inner">
    <p class="v-eyebrow" id="vc-label">Clients and partners</p>
    {voices.length > 0 && (
      <div class="vc_voices" data-rv="home-quote">
        <div class="vc_quotes">
          {voices.map((v) => (
            <figure class="vc_quote" id={`vc-q-${v.id}`}>
              <blockquote class="vc_text"><p>{v.lead}{v.soft && <Fragment> <span class="v-soft">{v.soft}</span></Fragment>}</p></blockquote>
              <figcaption class="vc_sr">{v.author}{v.role && `, ${v.role}`}</figcaption>
            </figure>
          ))}
        </div>
        {voices.length > 1 ? (
          <fieldset class="vc_who">
            <legend class="vc_sr">Show the quote of</legend>
            {voices.map((v, i) => (
              <label class="vc_chip">
                <input aria-controls={`vc-q-${v.id}`} checked={i === 0} class="vc_radio" name="vc-voice" type="radio" value={v.id} />
                {v.portrait && <img alt="" class="vc_pic" decoding="async" height="48" loading="lazy" src={v.portrait} width="48" />}
                <span class="vc_chiptext"><span class="vc_name">{v.author}</span>{v.role && <span class="vc_role">{v.role}</span>}</span>
              </label>
            ))}
          </fieldset>
        ) : (
          <div aria-hidden="true" class="vc_who">
            <span class="vc_chip vc_chip--one">
              {voices[0].portrait && <img alt="" class="vc_pic" decoding="async" height="48" loading="lazy" src={voices[0].portrait} width="48" />}
              <span class="vc_chiptext"><span class="vc_name">{voices[0].author}</span>{voices[0].role && <span class="vc_role">{voices[0].role}</span>}</span>
            </span>
          </div>
        )}
      </div>
    )}
    <ul aria-labelledby="vc-label" class="vc_row" role="list">
      {logos.map((l) => (
        <li class="vc_cell">
          {l.href || l.site ? (
            <a class="vc_tile vc_tile--link" href={l.href || l.site}>
              <img alt={l.name} class="vc_logo" loading="lazy" src={l.src} width={l.w} height={l.h} style={`--h:${l.h}px`} />
              <span class="vc_sr">{l.href ? ' case study' : ' website'}</span>
              <span aria-hidden="true" class="vc_arrow">↗</span>
            </a>
          ) : (
            <span class="vc_tile">
              <img alt={l.name} class="vc_logo" loading="lazy" src={l.src} width={l.w} height={l.h} style={`--h:${l.h}px`} />
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* On white, between the hero and "What we do", with room around it (the
     next section draws the rule under it) */
  .vc { background: var(--white); border-top: 1px solid var(--line); }
  .vc_inner { display: flex; flex-direction: column; align-items: flex-start; max-width: var(--container); margin: 0 auto; padding: 120px clamp(24px, 4vw, 48px) 112px; }
  .vc_sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* The quotes, at headline size, in one grid cell: the cell takes the
     tallest, each sits on the bottom edge, right above its author */
  .vc_voices { width: 100%; margin-top: 32px; }
  .vc_quotes { display: grid; }
  .vc_quote { grid-area: 1 / 1; align-self: end; margin: 0; }
  .vc_text { margin: 0; padding: 0; border: 0; }
  .vc_text p { max-width: 24em; margin: 0; color: var(--deep-blue); font-family: var(--font-display); font-size: 52px; font-style: italic; font-weight: 400; line-height: 1.1; letter-spacing: -.015em; text-wrap: balance; }
  /* Without :has(), the first quote only */
  .vc_quote + .vc_quote { display: none; }
  @supports selector(:has(*)) {
    .vc_quote + .vc_quote { display: block; }
    .vc_quote { visibility: hidden; opacity: 0; transition: opacity .3s, visibility 0s .3s; }
    .vc_voices:not(:has(.vc_radio)) .vc_quote,
    .vc_voices:has(.vc_chip:nth-of-type(1) .vc_radio:checked) .vc_quote:nth-child(1),
    .vc_voices:has(.vc_chip:nth-of-type(2) .vc_radio:checked) .vc_quote:nth-child(2),
    .vc_voices:has(.vc_chip:nth-of-type(3) .vc_radio:checked) .vc_quote:nth-child(3),
    .vc_voices:has(.vc_chip:nth-of-type(4) .vc_radio:checked) .vc_quote:nth-child(4) { visibility: visible; opacity: 1; transition: opacity .3s; }
  }

  /* The authors: the one quoted on a white card, the others to pick */
  .vc_who { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; min-width: 0; margin: 36px 0 0; padding: 0; border: 0; }
  .vc_chip { position: relative; display: flex; align-items: center; gap: 14px; min-width: 0; margin: 0; padding: 12px 16px 12px 12px; border: 1px solid var(--line); border-radius: 16px; font-weight: 400; cursor: pointer; transition: background-color .2s, border-color .2s, box-shadow .2s; }
  .vc_chip:hover { border-color: var(--line-strong); background: var(--paper); }
  .vc_chip:has(.vc_radio:checked), .vc_chip--one { border-color: var(--line-strong); background: var(--white); box-shadow: var(--shadow-1); cursor: default; }
  .vc_chip:has(.vc_radio:focus-visible) { outline: 2px solid var(--green-ink); outline-offset: 3px; }
  .vc_radio { position: absolute; width: 1px; height: 1px; margin: 0; opacity: 0; pointer-events: none; }
  .vc_pic { flex-shrink: 0; width: 48px; height: 48px; border: 1px solid var(--line-strong); border-radius: 50%; object-fit: cover; filter: grayscale(1) contrast(1.04); opacity: .55; transition: opacity .2s; }
  .vc_chip:hover .vc_pic, .vc_chip:has(.vc_radio:checked) .vc_pic, .vc_chip--one .vc_pic { opacity: 1; }
  .vc_chiptext { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .vc_name { color: var(--ink); font-size: 15px; font-weight: 600; line-height: 1.3; }
  .vc_role { color: var(--muted); font-size: 13px; line-height: 1.4; text-wrap: pretty; }
  @media (prefers-reduced-motion: reduce) {
    .vc_quote, .vc_chip, .vc_pic { transition: none !important; }
  }

  /* One framed tile per client, the logos in one tone until hovered */
  .vc_row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; width: 100%; margin: 72px 0 0; padding: 0; list-style: none; }
  .vc_cell { display: flex; min-width: 0; }
  .vc_tile { position: relative; display: grid; place-items: center; flex: 1; min-width: 0; height: 104px; padding: 0 22px; border: 1px solid var(--line); border-radius: 16px; background: var(--paper); text-decoration: none; transition: border-color .2s, box-shadow .2s, background-color .2s; }
  .vc_logo { display: block; width: auto; max-width: 100%; height: var(--h); filter: grayscale(1); opacity: .82; transition: filter .2s, opacity .2s; }
  .vc_arrow { position: absolute; top: 12px; right: 14px; color: var(--muted); font-size: 14px; line-height: 1; opacity: .55; transition: opacity .2s, color .2s, transform .2s; }
  .vc_tile--link:hover { border-color: var(--line-strong); background: var(--white); box-shadow: var(--shadow-1); }
  .vc_tile--link:hover .vc_logo, .vc_tile--link:focus-visible .vc_logo { filter: none; opacity: 1; }
  .vc_tile--link:hover .vc_arrow { color: var(--green-ink); opacity: 1; }
  .vc_tile--link:focus-visible { outline: 2px solid var(--green-ink); outline-offset: 3px; }
  @media (prefers-reduced-motion: no-preference) { .vc_tile--link:hover .vc_arrow { transform: translate(2px, -2px); } }
  @media (prefers-reduced-motion: reduce) { .vc_tile, .vc_logo, .vc_arrow { transition: none; } }

  @media (max-width: 1199px) {
    .vc_text p { font-size: 42px; }
    .vc_tile { padding: 0 14px; }
  }
  /* Tablets: the authors one under the other, three tiles a row */
  @media (max-width: 991px) {
    .vc_inner { padding-top: 96px; padding-bottom: 104px; }
    .vc_text p { font-size: 40px; }
    .vc_who { grid-template-columns: minmax(0, 1fr); gap: 8px; max-width: 560px; }
    .vc_row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 64px; }
    .vc_tile { height: 92px; }
  }
  @media (max-width: 767px) {
    .vc_inner { padding-top: 72px; padding-bottom: 80px; }
    .vc_voices { margin-top: 24px; }
    .vc_text p { font-size: 32px; line-height: 1.14; }
    .vc_who { margin-top: 28px; }
    .vc_chip { gap: 12px; padding: 10px 14px 10px 10px; }
    .vc_pic { width: 40px; height: 40px; }
    .vc_logo { height: calc(var(--h) * .92); }
  }
  /* Phones: two tiles a row */
  @media (max-width: 479px) {
    .vc_text p { font-size: 27px; }
    .vc_row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 48px; }
    .vc_tile { height: 78px; padding: 0 12px; border-radius: 14px; }
    .vc_arrow { top: 9px; right: 10px; font-size: 12px; }
  }
</style>
