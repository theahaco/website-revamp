---
// Home page section: logos, in the open (no tiles, no grid rules), under the
// key figures: clients and partners, then the security auditors we have
// worked with, each row under its label. A logo links only to the public case
// study of that same client; the others stay static.

// h: logo height in px on desktop (per file, for an even optical weight);
// w: its width at that height (from the file's proportions).
const logos = [
  { name: 'Stellar Development Foundation', src: '/images/logos/logo-light-stellar.svg', h: 22, w: 90, href: '/case-studies/stellar-development-foundation' },
  { name: 'Société Générale-FORGE', src: '/images/logos/logo-light-sgforge.svg', h: 26, w: 90, href: '/case-studies/societe-generale-forge' },
  { name: 'Ripple', src: '/images/logos/logo-light-ripple.svg', h: 22, w: 85, href: '/case-studies/ripple' },
  { name: 'Filecoin', src: '/images/logos/logo-light-filecoin.svg', h: 25, w: 87 },
  { name: 'LI.FI', src: '/images/logos/logo-light-lifi.svg', h: 23, w: 63, href: '/case-studies/lifi' },
  { name: 'Banque Delubac et Cie', src: '/images/logos/logo-light-delubac.svg', h: 25, w: 111 },
];

// Security auditors we have worked with, as logos (the firms' own artwork,
// taken from their sites; shown in one tone like the client logos).
// h: logo height in px on desktop; w: its width at that height.
const auditors = [
  { name: 'Hacken', src: '/images/logos/logo-hacken.svg', h: 12, w: 115 },
  { name: 'Halborn', src: '/images/logos/logo-halborn.svg', h: 12, w: 117 },
  { name: 'Runtime Verification', src: '/images/logos/logo-runtime-verification.png', h: 28, w: 142 },
  { name: 'Veridise', src: '/images/logos/logo-veridise.svg', h: 25, w: 111 },
  { name: 'Arda', src: '/images/logos/logo-arda.png', h: 25, w: 85 },
];
---
<section aria-label="Clients and partners" class="logos_section lg" data-rv="logos">
  <div class="logos_container lg_container">
    <div class="lg_inner">
      <div class="lg_group">
        <p class="lg_label" id="lg-clients"><span aria-hidden="true" class="lg_dot"></span>Clients and partners</p>
        <ul aria-labelledby="lg-clients" class="lg_row" role="list">
          {logos.map((l) => (
            <li class="lg_cell">
              {l.href ? (
                <a class="lg_tile lg_tile--link" href={l.href}>
                  <img alt={l.name} class="lg_logo" loading="lazy" src={l.src} width={l.w} height={l.h} style={`--h:${l.h}px`} />
                  <span class="lg_sr"> case study</span>
                </a>
              ) : (
                <span class="lg_tile">
                  <img alt={l.name} class="lg_logo" loading="lazy" src={l.src} width={l.w} height={l.h} style={`--h:${l.h}px`} />
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
      <div class="lg_group lg_group--auditors">
        <p class="lg_label" id="lg-auditors"><span aria-hidden="true" class="lg_dot"></span>Auditors we work with</p>
        <ul aria-labelledby="lg-auditors" class="lg_row" role="list">
          {auditors.map((a) => (
            <li class="lg_cell">
              <span class="lg_tile">
                <img alt={a.name} class="lg_logo" loading="lazy" src={a.src} width={a.w} height={a.h} style={`--h:${a.h}px`} />
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* One hairline under the key figures, at the width of the content; each
     label above its row, the logos spread across it */
  .lg_container { padding-top: 0; padding-bottom: 0; row-gap: 0; }
  .lg_inner { display: flex; flex-direction: column; gap: 48px; padding: 48px 0 88px; border-top: 1px solid var(--line); }
  .lg_group { display: flex; flex-direction: column; gap: 22px; }
  .lg_label { display: flex; align-items: center; gap: 8px; margin: 0; color: var(--muted); font-size: 12px; font-weight: 600; line-height: 1.35; letter-spacing: .08em; text-transform: uppercase; }
  .lg_dot { flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--vibrant-green); }

  .lg_row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 32px; margin: 0; padding: 0; list-style: none; }
  .lg_cell { display: flex; min-width: 0; }
  .lg_tile { display: grid; place-items: center; padding: 6px 0; color: var(--muted); text-decoration: none; }
  .lg_logo { display: block; width: auto; max-width: 100%; height: var(--h); }
  .lg_tile--link { border-radius: 6px; }
  .lg_tile--link:focus-visible { outline: 2px solid var(--green-ink); outline-offset: 6px; }
  .lg_sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Tablets and phones: three, then two logos a row, from the left */
  @media (max-width: 991px) {
    .lg_inner { gap: 40px; padding: 40px 0 72px; }
    .lg_row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 24px; justify-items: start; }
  }
  @media (max-width: 767px) {
    .lg_inner { padding: 36px 0 56px; border-top: 0; }
    .lg_logo { height: calc(var(--h) * .92); }
  }
  @media (max-width: 479px) {
    .lg_row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
