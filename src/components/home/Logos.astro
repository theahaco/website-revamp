---
// Home page section: logos. Clients and partners, as framed tiles continuing
// the key figures' frame above. A tile links only to the public case study of
// that same client; the other tiles stay static. Under them, the third-party
// audits of what we shipped, each linking to the page that states it (the
// case study or the tool page, where the audit and its date are written).
import Icon from '../Icon.astro';

// h: logo height in px on desktop (per file, for an even optical weight);
// w: its width at that height (from the file's proportions).
const logos = [
  { name: 'Stellar Development Foundation', src: '/images/logos/logo-light-stellar.svg', h: 22, w: 90, href: '/case-studies/stellar-development-foundation' },
  { name: 'Société Générale-FORGE', src: '/images/logos/logo-light-sgforge.svg', h: 26, w: 90, href: '/case-studies/societe-generale-forge' },
  { name: 'Ripple', src: '/images/logos/logo-light-ripple.svg', h: 22, w: 85, href: '/case-studies/ripple' },
  { name: 'Filecoin', src: '/images/logos/logo-light-filecoin.svg', h: 25, w: 87 },
  { name: 'LI.FI', src: '/images/logos/logo-light-lifi.svg', h: 23, w: 63, href: '/case-studies/lifi' },
  { name: 'Banque Delubac et Cie', src: '/images/logos/logo-light-delubac.svg', h: 25, w: 111 },
];

const audits = [
  { firm: 'Hacken', scope: 'EURCV, before mainnet', href: '/case-studies/societe-generale-forge' },
  { firm: 'Halborn', scope: 'LI.FI on Stellar, before production', href: '/case-studies/lifi' },
  { firm: 'Runtime Verification', scope: 'Moonlight core contracts, no critical or high findings, July 2026', href: '/open-source/moonlight' },
  { firm: 'Veridise', scope: 'Stellar Registry, no findings, November 2025', href: '/open-source/stellar-registry' },
];
---
<section aria-label="Clients and partners" class="logos_section lg" data-rv="logos">
  <div class="logos_container lg_container">
    <ul aria-label="Clients and partners" class="lg_grid" role="list">
      <li aria-hidden="true" class="lg_label"><span class="lg_dot"></span>Clients and partners</li>
      {logos.map((l) => (
        <li class="lg_cell">
          {l.href ? (
            <a class="lg_tile lg_tile--link" href={l.href}>
              <img alt={l.name} class="lg_logo" loading="lazy" src={l.src} width={l.w} height={l.h} style={`--h:${l.h}px`} />
              <span class="lg_sr"> case study</span>
              <span class="lg_arrow"><Icon name="arrow-up-right" size={16} /></span>
            </a>
          ) : (
            <div class="lg_tile">
              <img alt={l.name} class="lg_logo" loading="lazy" src={l.src} width={l.w} height={l.h} style={`--h:${l.h}px`} />
            </div>
          )}
        </li>
      ))}
    </ul>
    <ul aria-label="Third-party audits" class="lg_grid lg_grid--audits" role="list">
      <li aria-hidden="true" class="lg_label"><span class="lg_dot"></span>Third-party audits</li>
      {audits.map((a) => (
        <li class="lg_cell lg_cell--audit">
          <a class="lg_tile lg_tile--link lg_audit" href={a.href}>
            <span class="lg_audit-firm"><Icon name="shield-check" size={18} />{a.firm}</span>
            <span class="lg_audit-scope">{a.scope}</span>
            <span class="lg_arrow"><Icon name="arrow-up-right" size={16} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* The band's own padding goes: the frame touches its top and bottom rules */
  .lg_container { --pad: 28px; padding-top: 0; padding-bottom: 0; row-gap: 0; }
  .lg_grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); border-left: 1px solid var(--line); border-right: 1px solid var(--line); }
  .lg_grid > li { background: var(--white); }

  /* Labels start where the key figures' text starts; the dot hangs in the padding */
  .lg_label { display: flex; align-items: center; margin: 0; padding: 18px 12px 18px var(--pad); font-size: 12px; font-weight: 600; line-height: 1.35; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); text-wrap: balance; }
  .lg_dot { flex-shrink: 0; width: 6px; height: 6px; margin: 0 8px 0 -14px; border-radius: 50%; background: var(--vibrant-green); }

  .lg_cell { display: flex; min-height: 108px; }
  .lg_tile { position: relative; display: grid; place-items: center; flex: 1; min-width: 0; padding: 20px 12px; color: var(--muted); text-decoration: none; transition: background-color .2s; }
  .lg_logo { display: block; width: auto; max-width: 100%; height: var(--h); }
  .lg_tile--link:hover { background: var(--tint-paper); }
  .lg_tile--link:focus-visible { outline-offset: -3px; }
  .lg_arrow { position: absolute; top: 10px; right: 10px; display: inline-flex; color: var(--muted); transition: opacity .2s, transform .2s, color .2s; }
  .lg_tile--link:hover .lg_arrow, .lg_tile--link:focus-visible .lg_arrow { color: var(--green-ink); opacity: 1; transform: translate(2px, -2px); }
  @media (hover: hover) { .lg_arrow { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .lg_arrow { transition: none; transform: none !important; } }
  /* Audits: the firm in place of a logo, what it audited under it */
  .lg_grid--audits { grid-template-columns: minmax(0, 1fr) repeat(4, minmax(0, 1.5fr)); gap: 0; background: var(--white); border-top: 1px solid var(--line); }
  .lg_cell--audit { min-height: 92px; }
  .lg_audit { place-items: initial; display: flex; flex-direction: column; justify-content: center; gap: 4px; padding: 18px 28px 18px 24px; }
  .lg_audit-firm { display: inline-flex; align-items: center; gap: 8px; color: var(--deep-blue); font-size: 16px; font-weight: 600; line-height: 1.25; --icon-tint: var(--vibrant-green); --icon-tint-opacity: .5; }
  .lg_audit-scope { padding-left: 26px; color: var(--muted); font-size: 14px; line-height: 1.4; }
  .lg_sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }


  @media (max-width: 1199px) {
    .lg_grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lg_grid--audits { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lg_label { grid-column: 1 / -1; padding-top: 14px; padding-bottom: 14px; }
    .lg_cell { min-height: 100px; }
  }
  @media (max-width: 991px) {
    .lg_container { --pad: 24px; }
  }
  @media (max-width: 767px) {
    .lg_container { --pad: 20px; }
    .lg_grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lg_cell { min-height: 88px; }
    .lg_grid--audits { grid-template-columns: minmax(0, 1fr); }
    .lg_cell--audit { border-top: 1px solid var(--line); }
    .lg_cell--audit { min-height: 0; }
    .lg_audit { padding: 14px 40px 14px var(--pad); }
    .lg_logo { height: calc(var(--h) * .92); }
  }
</style>
