---
// Home page section "Ways to work with us": the team photo as the section's
// visual, then the four engagement models in one numbered row.
import Icon from '../Icon.astro';

interface Way { title: string; body: string; first: string }

const ways: Way[] = [
  { title: 'Integration partner', body: 'Fixed scope, milestone-based, our team end to end. As with EURCV and LI.FI.', first: 'scoping session' },
  { title: 'Architecture lead with your engineers', body: 'We design the system and lead delivery inside your engineering team. As with the settlement stablecoin of a top US commercial bank.', first: 'architecture note' },
  { title: 'Embedded principal engineer', body: 'A principal engineer placed with your team for a quarter or more. As with the Stellar Development Foundation.', first: 'onboarding' },
  { title: 'Programs for ecosystems', body: 'DevX audits, tooling roadmaps, accelerator and hackathon mentoring. As with Ripple.', first: 'DevX audit' },
];
---
<section class="ways_section" id="ways">
  <div class="section-inner">
    <div class="wy-top">
      <div class="wy-text">
        <p class="v-eyebrow">Engagement models</p>
        <h2 class="section_h2 wy-h2">Ways to work with us. <span class="v-soft">Our team end&nbsp;to&nbsp;end, or inside yours.</span></h2>
        <p class="wy-lede">Four models, one team. Each has a defined first two weeks, and every call is with one of our engineers.</p>
      </div>
      <figure class="wy-team">
        <picture><source media="(max-width: 767px)" srcset="/images/photos/team-photo-office-960.webp 960w, /images/photos/team-photo-office.webp 1600w" sizes="100vw" width="1600" height="1065" /><img alt="The Aha Company engineering team" class="wy-team-img" decoding="async" height="1065" loading="lazy" sizes="(max-width: 991px) 92vw, 640px" src="/images/photos/team-photo-office-960.webp" srcset="/images/photos/team-photo-office-960.webp 960w, /images/photos/team-photo-office.webp 1600w" width="1600" /></picture>
        <figcaption class="wy-caption"><Icon name="users-three" size={18} /><span class="wy-caption-title">The team</span><span aria-hidden="true" class="wy-sep">·</span><span data-rv="ways-team-caption">United States · Europe · Brazil</span></figcaption>
      </figure>
    </div>

    <ol class="wy-grid" role="list">
      {ways.map((w, i) => (
        <li class="wy-card">
          <p aria-hidden="true" class="wy-num">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="wy-h3">{w.title}</h3>
          <p class="wy-body">{w.body}</p>
          <p class="wy-first"><Icon name="calendar-check" size={20} /><span class="wy-first-text"><span class="wy-first-label">First two weeks</span> <span class="wy-first-val">{w.first}</span></span></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Text and photo side by side; the photo's bottom edge sits on the top
     rule of the models row */
  .wy-top { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 64px; align-items: end; }
  .wy-text { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; padding-bottom: 40px; }
  .wy-h2 { max-width: 13em; text-wrap: balance; }
  .wy-h2 .v-soft { display: block; }
  .wy-lede { margin: 0; max-width: 32em; color: var(--ink-2); font-size: 17px; line-height: 1.55; text-wrap: pretty; }

  .wy-team { position: relative; margin: 0 0 -1px; overflow: hidden; border-radius: var(--radius-lg) var(--radius-lg) 0 0; background: var(--deep-blue); }
  .wy-team-img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; object-position: 50% 55%; }
  .wy-caption { position: absolute; left: 20px; bottom: 20px; display: inline-flex; align-items: center; gap: 8px; max-width: calc(100% - 40px); padding: 10px 16px 10px 12px; border-radius: 999px; background: rgba(255, 255, 255, .94); box-shadow: var(--shadow-1); color: var(--ink-2); font-size: 15px; line-height: 1.3; --icon-tint: var(--vibrant-green); --icon-tint-opacity: .5; }
  .wy-caption :global(.icon) { color: var(--deep-blue); }
  .wy-caption-title { color: var(--deep-blue); font-weight: 600; }
  .wy-sep { color: var(--muted); }

  /* The four models in one frame, sharing 1 px rules */
  .wy-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg) 0 var(--radius-lg) var(--radius-lg); overflow: hidden; }
  .wy-card { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; background: var(--white); }
  .wy-num { margin: 0; padding: 24px 24px 0; color: var(--muted); font-size: 13px; font-weight: 500; line-height: 1; }
  .wy-h3 { margin: 0; padding: 14px 24px 10px; color: var(--deep-blue); font-family: var(--font-display); font-size: 24px; font-style: italic; font-weight: 400; line-height: 1.2; text-wrap: balance; }
  .wy-body { margin: 0; padding: 0 24px 20px; color: var(--ink-2); font-size: 16px; line-height: 1.55; }
  .wy-first { display: flex; align-items: center; align-self: end; justify-self: start; gap: 12px; margin: 0 24px 24px; padding: 11px 18px 11px 14px; border-radius: 12px; background: var(--tint-pink); --icon-tint: var(--vibrant-green); --icon-tint-opacity: .45; }
  .wy-first :global(.icon) { color: var(--deep-blue); }
  .wy-first-text { display: flex; flex-direction: column; gap: 3px; }
  .wy-first-label { color: var(--deep-blue); font-size: 12px; font-weight: 600; line-height: 1.2; letter-spacing: .08em; text-transform: uppercase; }
  .wy-first-val { color: var(--ink); font-size: 15px; font-weight: 500; line-height: 1.3; }
  .wy-first-val::first-letter { text-transform: uppercase; }

  @media (max-width: 1199px) {
    .wy-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 991px) {
    .wy-top { grid-template-columns: minmax(0, 1fr); row-gap: 8px; }
    .wy-grid { border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
    .wy-text { padding-bottom: 32px; }
  }
  @media (max-width: 767px) {
    .wy-team { border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
    .wy-caption { left: 12px; bottom: 12px; max-width: calc(100% - 24px); padding: 8px 12px 8px 10px; font-size: 13px; }
  }
  @media (max-width: 599px) {
    .wy-grid { grid-template-columns: minmax(0, 1fr); }
    .wy-num { padding: 22px 20px 0; }
    .wy-h3 { padding: 12px 20px 10px; }
    .wy-body { padding: 0 20px 18px; }
    .wy-first { margin: 0 20px 20px; }
    .wy-caption { flex-wrap: wrap; row-gap: 2px; border-radius: 16px; }
  }
</style>
