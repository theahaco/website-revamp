---
// Home hero: the proof panel. Three engagements live on mainnet, each row
// linking to its case study, with the facts of src/content/case-studies
// (status, network, the EURCV figure and its receipt, the bank's five months
// from kickoff to handover). The audits are in the row under the logos.
// Each row leads with what is live, the client under it. The round glyph is
// the kind of asset, drawn like a token icon (not the asset's own logo):
// a euro coin, a settlement coin, a cross-chain route; deep blue for
// financial institutions, green for protocols. The client logos are in the
// band under the hero.

const receipt = 'https://stellar.expert/explorer/public/asset/EURCV-GCEYGIVOLAVBF2TG2RUSGTUJCIN75KEX3NGLMY4VPL4GFE5L355AXW3G';
---
<figure aria-label="Live on mainnet" class="hp">
  <div aria-hidden="true" class="hp_grid v-blueprint"></div>
  <div aria-hidden="true" class="hp_sheet hp_sheet--back"></div>
  <div aria-hidden="true" class="hp_sheet hp_sheet--mid"></div>
  <div class="hp_card">
    <div class="hp_head">
      <p class="hp_title">Live on mainnet</p>
    </div>
    <ul class="hp_rows" role="list">
      <li class="hp_row">
        <span aria-hidden="true" class="hp_av"><svg viewBox="0 0 46 46"><circle cx="23" cy="23" r="23" fill="#1A3B60" /><circle cx="23" cy="23" r="19" fill="none" stroke="#fff" stroke-opacity=".22" /><text x="23" y="30.5" fill="#fff" font-family="Space Grotesk, system-ui, sans-serif" font-size="21" font-weight="600" text-anchor="middle">€</text></svg></span>
        <p class="hp_name"><a class="hp_link" href="/case-studies/societe-generale-forge">EURCV, regulated euro stablecoin<span aria-hidden="true" class="hp_arrow">&nbsp;→</span></a></p>
        <p class="hp_desc">Société Générale-FORGE · Stellar</p>
        <div class="hp_meta">
          <span class="hp_status"><span aria-hidden="true" class="v-live"></span><span data-rv="card-eurcv">Live since Q1 2026</span></span>
        </div>
        <div class="hp_fig"><span class="hp_figv">€20M+</span><span class="hp_figl">issued<a aria-label="Receipt: EURCV on the Stellar explorer" class="receipt-badge hp_receipt" href={receipt} title="Receipt">✓</a></span></div>
      </li>
      <li class="hp_row">
        <span aria-hidden="true" class="hp_av"><svg viewBox="0 0 46 46"><circle cx="23" cy="23" r="23" fill="#1A3B60" /><circle cx="23" cy="23" r="19" fill="none" stroke="#fff" stroke-opacity=".22" /><path d="M15.5 19.5h15m-3.6-3.6 3.6 3.6-3.6 3.6M30.5 26.5h-15m3.6-3.6-3.6 3.6 3.6 3.6" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" /></svg></span>
        <p class="hp_name"><a class="hp_link" href="/case-studies/nda-settlement-stablecoin">Settlement stablecoin<span aria-hidden="true" class="hp_arrow">&nbsp;→</span></a></p>
        <p class="hp_desc">Top US commercial bank · Stellar</p>
        <div class="hp_meta">
          <span class="hp_status"><span aria-hidden="true" class="v-live"></span><span data-rv="card-bank">Live since Q3 2026</span></span>
        </div>
        <div class="hp_fig"><span class="hp_figv">5 months</span><span class="hp_figl">to handover</span></div>
      </li>
      <li class="hp_row">
        <span aria-hidden="true" class="hp_av"><svg viewBox="0 0 46 46"><circle cx="23" cy="23" r="23" fill="#367A12" /><circle cx="23" cy="23" r="19" fill="none" stroke="#fff" stroke-opacity=".22" /><path d="M16.5 28.5c0-6.5 13-3.5 13-11" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="2.1" /><circle cx="16.5" cy="29.5" r="3" fill="#367A12" stroke="#fff" stroke-width="2.1" /><circle cx="29.5" cy="16.5" r="3.2" fill="#fff" /></svg></span>
        <p class="hp_name"><a class="hp_link" href="/case-studies/lifi">Cross-chain asset transfers<span aria-hidden="true" class="hp_arrow">&nbsp;→</span></a></p>
        <p class="hp_desc">LI.FI · Stellar</p>
        <div class="hp_meta">
          <span class="hp_status"><span aria-hidden="true" class="v-live"></span><span>Live</span></span>
        </div>
      </li>
    </ul>
  </div>
</figure>

<style>
  /* Stage: the card on two offset sheets, over a faint blueprint grid */
  .hp { position: relative; margin: 0; padding: 22px 26px 36px 4px; container-type: inline-size; }
  .hp_grid { position: absolute; inset: -64px -40px -72px -72px; z-index: 0; -webkit-mask-image: radial-gradient(closest-side, #000 45%, transparent); mask-image: radial-gradient(closest-side, #000 45%, transparent); }
  .hp_sheet { position: absolute; z-index: 0; border: 1px solid var(--line); border-radius: 20px; }
  .hp_sheet--back { inset: 48px 0 8px 30px; background: var(--tint-pink); }
  .hp_sheet--mid { inset: 35px 13px 22px 17px; background: var(--tint-blue); }

  .hp_card { position: relative; z-index: 1; background: var(--white); border: 1px solid var(--line-strong); border-radius: var(--radius-lg); box-shadow: var(--shadow-2); }
  .hp_head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 24px; background: var(--deep-blue); border-radius: 15px 15px 0 0; color: var(--white); }
  .hp_title { margin: 0; font-family: var(--font-display); font-size: 22px; font-style: italic; line-height: 1.2; }

  .hp_rows { margin: 0; padding: 0; list-style: none; }
  .hp_row { position: relative; display: grid; grid-template-columns: 46px minmax(0, 1fr) auto; grid-template-areas: 'tile name fig' 'tile desc fig' 'tile meta fig'; column-gap: 16px; align-items: center; padding: 18px 20px; border-top: 1px solid var(--line); transition: background-color .2s; }
  .hp_row:first-child { border-top: 0; }
  .hp_row:last-child { border-radius: 0 0 15px 15px; }
  .hp_row:hover { background: var(--paper); }

  .hp_av { grid-area: tile; align-self: center; display: block; width: 46px; height: 46px; }
  .hp_av svg { display: block; width: 100%; height: 100%; }

  .hp_name { grid-area: name; margin: 0; min-width: 0; font-size: 16px; font-weight: 600; line-height: 1.3; color: var(--deep-blue); }
  .hp_link { color: inherit; text-decoration: none; }
  /* The whole row is the link to the case study; the receipt stays its own link above it */
  .hp_link::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .hp_link:focus-visible { outline: none; }
  .hp_link:focus-visible::after { outline: 2px solid var(--green-ink); outline-offset: -3px; }
  .hp_row:last-child .hp_link::after { border-radius: 0 0 15px 15px; }
  .hp_arrow { position: relative; left: 0; font-weight: 500; color: var(--muted); transition: left .2s, color .2s; }
  .hp_row:hover .hp_link { color: var(--green-ink); }
  .hp_row:hover .hp_arrow { left: 3px; color: var(--green-ink); }

  .hp_desc { grid-area: desc; margin: 4px 0 0; font-size: 15px; line-height: 1.4; color: var(--muted); }
  .hp_meta { grid-area: meta; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 10px; }
  .hp_net, .hp_status { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 9px 0 7px; border-radius: 999px; font-size: 12px; font-weight: 600; line-height: 1; white-space: nowrap; }
  .hp_net { border: 1px solid var(--line); background: var(--white); color: var(--ink); }
  .hp_status { gap: 7px; padding: 0 10px 0 9px; background: var(--tint-green); color: #2f6e10; }
  .hp_status .v-live { width: 7px; height: 7px; }

  .hp_fig { grid-area: fig; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; justify-self: end; align-self: center; color: var(--deep-blue); }
  .hp_figv { font-size: 26px; font-weight: 500; line-height: 1; letter-spacing: -.025em; white-space: nowrap; }
  .hp_figl { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; line-height: 1; color: var(--muted); }
  .hp_receipt { z-index: 2; }

  @media (prefers-reduced-motion: reduce) { .hp_row, .hp_arrow { transition: none; } .hp_row:hover .hp_arrow { left: 0; } }
  .hp_sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Narrow panel (1024 px): the figure under the facts */
  @container (max-width: 460px) {
    .hp_row { grid-template-columns: 42px minmax(0, 1fr); grid-template-areas: 'tile name' 'tile desc' 'tile meta' 'tile fig'; column-gap: 14px; padding: 16px 18px 16px 16px; }
    .hp_av { align-self: start; width: 42px; height: 42px; margin-top: 2px; }
    .hp_fig { flex-direction: row; align-items: center; gap: 8px; justify-self: start; margin-top: 12px; }
    .hp_head { padding: 14px 18px; }
  }
  /* Phones: the tile next to the name, the facts at full width under it */
  @container (max-width: 380px) {
    .hp_row { grid-template-columns: 40px minmax(0, 1fr); grid-template-areas: 'tile name' 'desc desc' 'meta meta' 'fig fig'; column-gap: 12px; padding: 16px; }
    .hp_av { align-self: center; width: 40px; height: 40px; margin-top: 0; }
    .hp_desc { margin-top: 12px; }
    .hp_head { padding: 13px 16px; }
    .hp_title { font-size: 20px; }
  }

  @media (max-width: 991px) {
    .hp { max-width: 640px; padding: 22px 22px 36px 0; }
    .hp_grid { inset: -40px -12px -48px -12px; }
  }
  @media (max-width: 479px) {
    .hp { padding: 20px 14px 30px 0; }
    .hp_sheet--back { inset: 44px 0 6px 26px; }
    .hp_sheet--mid { inset: 32px 7px 18px 13px; }
    .hp_grid { inset: -24px -24px -32px -24px; }
  }
</style>
