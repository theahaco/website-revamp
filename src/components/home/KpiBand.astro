---
// Home: the key figures, full width under the hero (tablets and desktops;
// phones show them inside the hero). Figures as the site states them: the
// four networks (/networks), 137 on the Open source page (dated, with how it
// is counted), the team on About. EURCV's figure is in the proof panel. Icon tints follow the audience colors:
// financial institutions blue, ecosystems pink, neutral tan.
import Icon from '../Icon.astro';
import NetMark from './NetMark.astro';
import { toolAdoption } from '../../data/site';
---
<section aria-label="Key figures" class="kpi">
  <div class="kpi_inner">
    <ul class="kpi_grid" role="list">
      <li class="kpi_cell">
        <div class="kpi_top"><p class="kpi_value">4</p><span aria-hidden="true" class="kpi_marks"><NetMark net="stellar" size={17} /><NetMark net="xrpl" size={15} /><NetMark net="canton" size={17} /><NetMark net="ethereum" size={19} /></span></div>
        <p class="kpi_label">Networks we build on: Stellar, XRPL, Canton and Ethereum</p>
      </li>
      <li class="kpi_cell" data-rv="stat-deploy">
        <div class="kpi_top"><p class="kpi_value">20<span class="kpi_plus">+</span></p><span class="v-iconbox v-iconbox--tan kpi_icon"><Icon name="rocket-launch" size={28} /></span></div>
        <p class="kpi_label">Deployments on mainnet</p>
      </li>
      <li class="kpi_cell" data-rv="stat-os">
        <div class="kpi_top"><p class="kpi_value">{toolAdoption.count}</p><span class="v-iconbox v-iconbox--pink kpi_icon"><Icon name="git-branch" size={28} /></span></div>
        <p class="kpi_label">Projects using our <span class="kpi_nowrap">open-source</span> tools</p>
        <p class="kpi_meta"><span class="kpi_date kpi_nowrap">{toolAdoption.date}</span><a class="kpi_link kpi_nowrap" href="/open-source#how-we-count">How we count<span class="kpi_linkicon"><Icon name="arrow-right" size={14} /></span></a></p>
      </li>
      <li class="kpi_cell" data-rv="stat-team">
        <div class="kpi_top"><p class="kpi_value">12<span class="kpi_plus">+</span></p><span class="v-iconbox v-iconbox--tan kpi_icon"><Icon name="users-three" size={28} /></span></div>
        <p class="kpi_label">Engineers across the United States, Europe and Brazil</p>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Framed cells: the band's rules run full width, the cells share 1 px borders
     inside the container (the logo band below continues the same frame). */
  .kpi { background: var(--white); border-top: 1px solid var(--line); }
  .kpi_inner { max-width: var(--container); margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); }
  .kpi_grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); border-left: 1px solid var(--line); border-right: 1px solid var(--line); }
  .kpi_cell { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 32px 28px 30px; background: var(--white); }
  .kpi_top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 4px; }
  .kpi_value { margin: 0; font-size: clamp(38px, 4vw, 52px); font-weight: 500; line-height: 1; letter-spacing: -.035em; color: var(--deep-blue); white-space: nowrap; }
  .kpi_plus { color: var(--green-ink); }
  .kpi_icon { margin-top: -2px; }
  .kpi_marks { display: flex; align-items: center; gap: 10px; height: 48px; padding: 0 12px; border: 1px solid var(--line); border-radius: 12px; }
  .kpi_label { margin: 0; max-width: 28ch; font-size: 15px; line-height: 1.45; color: var(--ink-2); text-wrap: pretty; }
  .kpi_meta { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; margin: auto 0 0; padding-top: 8px; font-size: 14px; line-height: 1.45; color: var(--muted); }
  .kpi_link { font-weight: 600; color: var(--deep-blue); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; transition: color .2s, text-decoration-color .2s; }
  .kpi_link:hover { color: var(--green-ink); text-decoration-color: currentColor; }
  .kpi_nowrap { white-space: nowrap; }
  /* 44 px touch targets on the two links, without moving anything */
  @media (pointer: coarse) { .kpi_link { display: inline-block; padding: 12px 0; margin: -12px 0; } }
  .kpi_linkicon { display: inline-block; margin-left: 3px; vertical-align: -2px; }

  @media (max-width: 991px) {
    .kpi_grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kpi_cell { padding: 28px 24px 26px; }
  }
  /* Phones show the figures inside the hero instead */
  @media (max-width: 767px) {
    .kpi { display: none; }
  }
  @media (max-width: 479px) {
    .kpi_cell { gap: 8px; padding: 20px 20px 22px; }
    .kpi_top { flex-direction: column-reverse; gap: 14px; }
    .kpi_icon { width: 36px; height: 36px; margin-top: 0; border-radius: 10px; }
    .kpi_icon :global(svg) { width: 20px; height: 20px; }
    .kpi_value { font-size: 36px; }
    .kpi_label { font-size: 15px; }
    .kpi_meta { font-size: 14px; }
  }
  /* Small phones: one figure per row */
  @media (max-width: 374px) {
    .kpi_grid { grid-template-columns: minmax(0, 1fr); }
    .kpi_top { flex-direction: row; }
    .kpi_label { max-width: none; }
  }
</style>
