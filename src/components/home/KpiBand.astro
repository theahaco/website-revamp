---
// Home: the key figures, on a deep-blue banner full width under the hero
// (tablets and desktops; phones show them inside the hero). Numbers only, a
// hairline between them: deployments on mainnet, third-party security audits
// and projects using our open-source tools (counted on the Open source page).
// The values live in src/data/site.ts (keyFigures, toolAdoption).
import { keyFigures, toolAdoption } from '../../data/site';
---
<section aria-label="Key figures" class="kpi">
  <div class="kpi_inner">
    <ul class="kpi_grid" role="list">
      <li class="kpi_cell" data-rv="stat-deploy">
        <p class="kpi_value">{keyFigures.deployments.replace('+', '')}<span class="kpi_plus">+</span></p>
        <p class="kpi_label">Deployments on mainnet</p>
      </li>
      <li class="kpi_cell" data-rv="stat-audits">
        <p class="kpi_value">{keyFigures.audits}</p>
        <p class="kpi_label">Third-party security audits</p>
      </li>
      <li class="kpi_cell" data-rv="stat-os">
        <p class="kpi_value">{toolAdoption.count}</p>
        <p class="kpi_label">Projects using our <span class="kpi_nowrap">open-source</span> tools</p>
      </li>
    </ul>
  </div>
</section>

<style>
  /* The banner: white numbers on deep blue, a light hairline between them;
     the logo tiles follow on white (Logos.astro) */
  .kpi { background: var(--deep-blue); color: var(--white); }
  .kpi_inner { max-width: var(--container); margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); }
  .kpi_grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 60px 0; list-style: none; }
  .kpi_cell { display: flex; flex-direction: column; gap: 14px; min-width: 0; padding: 0 40px; border-left: 1px solid rgba(255, 255, 255, .16); }
  .kpi_cell:first-child { padding-left: 0; border-left: 0; }
  .kpi_value { margin: 0; color: var(--white); font-size: clamp(44px, 4.4vw, 60px); font-weight: 500; line-height: 1; letter-spacing: -.035em; white-space: nowrap; }
  /* Vibrant green on deep blue passes for large text (3.5:1) */
  .kpi_plus { color: var(--vibrant-green); }
  .kpi_label { margin: 0; max-width: 26ch; color: rgba(255, 255, 255, .76); font-size: 15px; line-height: 1.45; text-wrap: pretty; }
  .kpi_nowrap { white-space: nowrap; }

  @media (max-width: 991px) {
    .kpi_grid { padding: 48px 0; }
    .kpi_cell { padding: 0 24px; }
  }
  /* Phones show the figures inside the hero instead */
  @media (max-width: 767px) {
    .kpi { display: none; }
  }
</style>
