---
// Home: the key figures, full width under the hero, in the open (tablets and
// desktops; phones show them inside the hero). Numbers only, no icons, a
// hairline between them: deployments on mainnet, third-party audits, projects
// using our open-source tools (counted on the Open source page) and the year
// we were founded. The values live in src/data/site.ts (keyFigures,
// toolAdoption).
import { keyFigures, toolAdoption } from '../../data/site';
---
<section aria-label="Key figures" class="kpi">
  <div class="kpi_inner">
    <ul class="kpi_grid" role="list">
      <li class="kpi_cell" data-rv="stat-deploy">
        <p class="kpi_value">{keyFigures.deployments.replace('+', '')}<span class="kpi_plus">+</span></p>
        <p class="kpi_label">Deployments on mainnet</p>
      </li>
      <li class="kpi_cell" data-rv="stat-audits">
        <p class="kpi_value">{keyFigures.audits}</p>
        <p class="kpi_label">Third-party security audits</p>
      </li>
      <li class="kpi_cell" data-rv="stat-os">
        <p class="kpi_value">{toolAdoption.count}</p>
        <p class="kpi_label">Projects using our <span class="kpi_nowrap">open-source</span> tools</p>
      </li>
      <li class="kpi_cell" data-rv="stat-founded">
        <p class="kpi_value"><span class="kpi_since">Since</span> {keyFigures.founded}</p>
        <p class="kpi_label">Building blockchain infrastructure</p>
      </li>
    </ul>
  </div>
</section>

<style>
  /* In the open: four numbers on white, a hairline between them; the logo
     tiles follow under one hairline (Logos.astro) */
  .kpi { background: var(--white); border-top: 1px solid var(--line); }
  .kpi_inner { max-width: var(--container); margin: 0 auto; padding: 0 clamp(24px, 4vw, 48px); }
  .kpi_grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 64px 0 48px; list-style: none; }
  .kpi_cell { display: flex; flex-direction: column; gap: 14px; min-width: 0; padding: 0 32px; border-left: 1px solid var(--line); }
  .kpi_cell:first-child { padding-left: 0; border-left: 0; }
  .kpi_value { margin: 0; font-size: clamp(42px, 4.2vw, 56px); font-weight: 500; line-height: 1; letter-spacing: -.035em; color: var(--deep-blue); white-space: nowrap; }
  .kpi_plus { color: var(--green-ink); }
  .kpi_since { color: var(--muted); font-size: .42em; font-weight: 500; letter-spacing: 0; }
  .kpi_label { margin: 0; max-width: 24ch; font-size: 15px; line-height: 1.45; color: var(--ink-2); text-wrap: pretty; }
  .kpi_nowrap { white-space: nowrap; }

  @media (max-width: 1199px) {
    .kpi_cell { padding: 0 24px; }
  }
  /* Tablets: two by two, the hairline only between the two columns */
  @media (max-width: 991px) {
    .kpi_grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 36px; padding: 48px 0 40px; }
    .kpi_cell:nth-child(odd) { padding-left: 0; border-left: 0; }
  }
  /* Phones show the figures inside the hero instead */
  @media (max-width: 767px) {
    .kpi { display: none; }
  }
</style>
