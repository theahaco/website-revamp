---
// Home page section "What we do": the six services in framed cells. Each cell
// links to the service's card on /services (where its bullets are) and shows
// its precedents: client logos, anonymous clients behind a lock, our tools.
// Copy lives in ./services-data.ts, shared with src/pages/services.astro.
import Icon from '../Icon.astro';
import { services, tint, doors } from './services-data';
const cardHref = (a: keyof typeof doors) => (a === 'any' ? '#ways' : `/services${doors[a].href}`);
---
<section class="services_section" id="what-we-do">
  <div class="section-inner">
    <header class="wd-head">
      <div class="wd-titles">
        <p class="v-eyebrow">Services</p>
        <h2 class="section_h2">What we do</h2>
      </div>
      <a class="wd-all" href="/services">Services in detail <span aria-hidden="true">→</span></a>
    </header>

    <ul class="wd-grid" role="list">
      {services.map((s) => (
        <li class="wd-cell">
          <div class="wd-top">
            <span class:list={['v-iconbox', tint[s.audience] && `v-iconbox--${tint[s.audience]}`]}><Icon name={s.icon} size={28} /></span>
            <span class="wd-arrow"><Icon name="arrow-up-right" size={20} /></span>
          </div>
          <h3 class="wd-h3"><a class="wd-link" href={cardHref(s.audience)}>{s.title}</a></h3>
          <p class="wd-desc">{s.desc}</p>
          <div class="wd-precedent" data-rv={s.rv}>
            <p class="wd-label">Precedent</p>
            <ul class="wd-chips" role="list">
              {s.precedents.map((p) => (
                <li>
                  {p.kind === 'client' && (
                    <a class="wd-chip" href={p.href}><img class="wd-logo" src={p.logo} alt={p.alt} width={p.w} height={p.h} loading="lazy" />{p.text}</a>
                  )}
                  {p.kind === 'mark' && (
                    <a class="wd-chip" href={p.href}><img class="wd-mark" src={p.logo} alt="" width="16" height="16" loading="lazy" />{p.text}</a>
                  )}
                  {p.kind === 'nda' && (
                    <a class="wd-chip wd-chip--nda" href={p.href}><Icon name="lock-simple" size={16} />{p.text}</a>
                  )}
                  {p.kind === 'tool' && (
                    <a class="wd-chip wd-chip--tool" href={p.href}><Icon name={p.icon} size={16} />{p.text}</a>
                  )}
                </li>
              ))}
            </ul>
            {s.note && <p class="wd-note">{s.note}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wd-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .wd-titles { display: flex; flex-direction: column; gap: 20px; }
  .wd-all { display: inline-flex; align-items: center; gap: 6px; color: var(--deep-blue); font-size: 15px; font-weight: 600; text-decoration: none; transition: color .2s; }
  .wd-all:hover { color: var(--green-ink); }

  /* Framed cells sharing 1 px rules; titles, texts and precedents line up
     across a row (subgrid) */
  .wd-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .wd-cell { position: relative; display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; padding: 32px 32px 30px; background: var(--white); transition: background-color .2s; }
  .wd-cell:hover { background: var(--paper); }
  .wd-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24px; }
  .wd-arrow { display: inline-flex; color: var(--muted-2); transition: color .2s, transform .2s; }
  .wd-cell:hover .wd-arrow { color: var(--deep-blue); }
  @media (prefers-reduced-motion: no-preference) { .wd-cell:hover .wd-arrow { transform: translate(2px, -2px); } }

  .wd-h3 { margin: 0 0 12px; font-family: var(--font-display); font-size: 26px; font-style: italic; font-weight: 400; line-height: 1.2; color: var(--deep-blue); text-wrap: balance; }
  .wd-link { color: inherit; text-decoration: none; }
  /* The whole cell is the link to /services; the chips sit above it */
  .wd-link::after { content: ''; position: absolute; inset: 0; }
  .wd-link:focus-visible { outline: none; }
  .wd-link:focus-visible::after { outline: 2px solid var(--green-ink); outline-offset: -3px; border-radius: 2px; }
  .wd-desc { margin: 0; color: var(--ink-2); font-size: 16px; line-height: 1.55; }

  .wd-precedent { display: flex; flex-direction: column; gap: 10px; padding-top: 24px; }
  .wd-label { margin: 0; color: var(--muted); font-size: 12px; font-weight: 600; line-height: 1; letter-spacing: .08em; text-transform: uppercase; }
  .wd-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  /* A chip that has to wrap becomes a rounded rectangle, not a squeezed pill */
  .wd-chip { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 7px; min-height: 34px; padding: 6px 12px 6px 11px; border: 1px solid var(--line-strong); border-radius: 17px; background: var(--white); color: var(--deep-blue); font-size: 14px; font-weight: 500; line-height: 1.25; text-decoration: none; text-wrap: balance; transition: border-color .2s, color .2s; }
  .wd-chip:hover { border-color: var(--deep-blue); }
  .wd-chip--nda { border-color: transparent; background: var(--tint-paper); color: var(--ink-2); }
  .wd-chip--nda:hover { border-color: var(--line-strong); }
  .wd-chip--nda :global(.icon) { color: var(--muted); --icon-tint: var(--muted); }
  .wd-chip--tool :global(.icon) { --icon-tint: var(--vibrant-green); --icon-tint-opacity: .5; }
  .wd-logo { display: block; width: auto; }
  .wd-mark { display: block; width: 16px; height: 16px; object-fit: cover; object-position: left center; }
  .wd-note { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.45; }

  @media (pointer: coarse) { .wd-chip { min-height: 44px; border-radius: 22px; } .wd-all { min-height: 44px; } }
  @media (max-width: 1199px) {
    .wd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wd-cell { padding: 30px 28px 28px; }
  }
  @media (max-width: 599px) {
    .wd-grid { grid-template-columns: minmax(0, 1fr); }
    .wd-cell { padding: 28px 24px 26px; }
    .wd-h3 { font-size: 24px; }
  }
</style>
