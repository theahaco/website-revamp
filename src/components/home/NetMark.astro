---
// A network's symbol, cropped from the left of its logo in
// public/images/logos (each of these wordmarks starts with the symbol;
// `ratio` is the symbol's width over its height, measured on the file).
// Decorative: the network's name is always written next to it.
interface Props {
  net: 'stellar' | 'xrpl' | 'canton' | 'ethereum';
  size?: number;
  lazy?: boolean;
}
const marks = {
  stellar: { src: '/images/logos/logo-light-stellar.svg', ratio: 1.21 },
  xrpl: { src: '/images/logos/logo-xrpl-transparent.webp', ratio: 1.31 },
  canton: { src: '/images/logos/logo-light-canton.svg', ratio: 0.9 },
  ethereum: { src: '/images/logos/logo-ethereum.webp', ratio: 0.63 },
};
const { net, size = 16, lazy = false } = Astro.props;
const m = marks[net];
const width = Math.ceil(size * m.ratio);
---
<img alt="" class="netmark" src={m.src} width={width} height={size} loading={lazy ? 'lazy' : undefined} decoding="async" />

<style>
  .netmark { display: block; flex-shrink: 0; max-width: none; object-fit: cover; object-position: left center; }
</style>
