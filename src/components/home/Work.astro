---
// Home page section: work. Split out of src/pages/index.astro.
import HomeWork from '../HomeWork.astro';
---
<section id="work"><div class="section-inner work_layout"><div class="hw_head"><p class="v-eyebrow">Track record</p><h2 class="work_h2">Selected work</h2></div><HomeWork /></div></section>

<style>
  /* Eyebrow pill above the heading; the pair takes the heading's grid cell. */
  .hw_head { grid-row: 1; grid-column: 1; align-self: end; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; min-width: 0; }
  .hw_head > .work_h2 { align-self: flex-start; }
</style>
