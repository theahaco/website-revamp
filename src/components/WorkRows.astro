---
// The lists of the Work page. Case studies: the home page's tiles
// (WorkTile.astro), in the order of src/data/curation.ts (workOrder), then the
// open-source tools and the PwC US alliance as compact rows, the rows of the
// Services page (services/Precedents.astro). Articles: numbered rows with
// their text. Eyebrows, filter data and links are computed here;
// src/scripts/work.js only filters and switches views. Each filtered item
// carries its audience (data-fa); the tools count as one item each
// (data-wk-count).
import { caseStudies, posts, tools, formatDate, nobr, orderBy } from '../lib/content';
import { workOrder, workWideCases } from '../data/curation';
import { toolIcons } from '../lib/toolIcons';
import WorkTile from './WorkTile.astro';
import Precedents, { type PrecedentRow } from './services/Precedents.astro';

interface Props {
  kind: 'cases' | 'articles';
}
const { kind } = Astro.props;
const eyebrow = (aud: string, net: string) => (aud && net ? `${aud} · ${net}` : aud || net);
const allCases = kind === 'cases' ? orderBy(await caseStudies(), workOrder) : [];
// Alliances (PwC US) are not client engagements: one row, last, without a link.
const tileIds = allCases.filter((c) => !c.data.alliance).map((c) => c.id);
const alliances = allCases.filter((c) => c.data.alliance);
const articles = kind === 'articles' ? await posts() : [];
// Open-source tools are listed with the case studies, under "Ecosystems and
// open source", each with its headline figure: each has a case-study page of
// its own (/open-source/<id>).
const toolAudience = 'Ecosystems and open source';
const toolRows: PrecedentRow[] = (kind === 'cases' ? await tools() : []).map((t) => ({
  href: `/open-source/${t.id}`,
  name: t.data.name,
  line: t.data.summary,
  meta: [t.data.category, t.data.network].filter(Boolean).join(' · '),
  icon: toolIcons[t.id] ?? 'code',
  figure: t.data.headline.figure && t.data.headline.label ? { value: t.data.headline.figure, label: t.data.headline.label } : undefined,
}));
const allianceRow = (cs: (typeof alliances)[number]): PrecedentRow => ({
  name: cs.data.client || cs.data.title,
  line: cs.data.workLine,
  meta: [cs.data.facts.find((f) => f.label === 'Engagement')?.value || 'Co-selling alliance', cs.data.network].filter(Boolean).join(' · '),
  icon: 'handshake',
});
---
{kind === 'cases' && (
  <Fragment>
    <WorkTile ids={tileIds} wide={workWideCases} level={2} />
    {toolRows.length > 0 && (
      <div class="wr_group wr_tools" data-fa={toolAudience} data-wk-count={toolRows.length}>
        <Precedents label="Open-source tools" rows={toolRows} tint="pink" />
      </div>
    )}
    {alliances.map((cs) => (
      <div class="wr_group wr_alliance" data-fa={cs.data.audience} data-wk-alliance={cs.id}>
        <Precedents label="Alliance" rows={[allianceRow(cs)]} />
      </div>
    ))}
  </Fragment>
)}
{kind === 'articles' && (
  <div class="w-dyn-list">
    <div class="work_list w-dyn-items" role="list">
      {articles.map((post) => (
        <div class="work_item w-dyn-item" role="listitem" data-fa={post.data.audience}>
          <a class="work_article-link w-inline-block wr_link" href={`/blog/${post.id}`}>
            <span class="work_num"></span>
            <div class="work_stack">
              <div class="wr_head">
                <div class="work_meta">
                  <span class="work_eyebrow" data-row="eyebrow">{eyebrow(post.data.audience, post.data.network)}</span>
                  <span class="work_yeararrow"><span data-row="date">{formatDate(post.data.date, 'long')}</span><span> ↗</span></span>
                </div>
              </div>
              <h2 class="work_article-h3" data-row="title" set:html={nobr(post.data.title)} />
              {(post.data.readMinutes || post.data.authorName) && (
                <p class="wk_rowline">
                  {post.data.readMinutes && <span data-row="min">{post.data.readMinutes}</span>}
                  {post.data.readMinutes && <span> min · </span>}
                  {post.data.authorName && <span data-row="author">{post.data.authorName}</span>}
                </p>
              )}
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  /* Tools and alliance: the Services rows, under the tiles */
  .wr_group { margin-top: 56px; }
  /* Articles: number and text; on phones the number sits above the text (site.css) */
  .wr_head { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .wr_link .work_meta { min-height: 18px; }
  .work_article-h3 { transition: color .2s; }
  a.wr_link:hover .work_article-h3 { color: var(--green-ink); }
  @media (max-width: 767px) {
    .wr_group { margin-top: 40px; }
  }
  /* Small phones: the tools' figure labels, longer than those of the Services
     rows, wrap under their figure's line instead of running past the screen */
  @media (max-width: 479px) {
    .wr_tools :global(.pc_figl) { white-space: normal; line-height: 1.3; }
  }
</style>
