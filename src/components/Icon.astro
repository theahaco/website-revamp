---
// Inline SVG icon from src/icons (Phosphor duotone set, MIT licence: see
// src/icons/README.md). Usage: <Icon name="bank" size={28} />.
// The icon takes the text colour; its duotone layer takes --icon-tint
// (default: the text colour at 20% opacity), so a parent can set, e.g.,
// `--icon-tint: var(--vibrant-green); --icon-tint-opacity: .6`.
// Decorative by default (hidden from screen readers); pass `label` when the
// icon carries meaning on its own.
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 24, class: cls = '', label } = Astro.props;
const files = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const raw = files[`../icons/${name}.svg`];
if (!raw) throw new Error(`Icon "${name}" not found in src/icons (copy it from the Phosphor duotone set)`);
const a11y = label ? `role="img" aria-label="${label.replace(/"/g, '&quot;')}"` : 'aria-hidden="true" focusable="false"';
const svg = raw.replace('<svg ', `<svg width="${size}" height="${size}" class="icon ${cls}" ${a11y} `);
---
<Fragment set:html={svg} />
