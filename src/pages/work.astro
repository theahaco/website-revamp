---
// Generated from the Webflow page "/work". Edit freely: this file is the source now.
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRows from '../components/WorkRows.astro';
import { caseStudies, posts, tools } from '../lib/content';
// Case studies and the open-source tool pages share the first view.
const caseCount = (await caseStudies()).length + (await tools()).length;
// No article published yet (scheduled ones are left out on theaha.co): no Articles tab.
const hasPosts = (await posts()).length > 0;
import Cta from '../components/Cta.astro';
---
<BaseLayout title={'Blockchain case studies and open source | The Aha Company'} description={'Blockchain case studies and open-source tools from The Aha Company: stablecoins and tokenized funds for institutions, integrations for protocols, tooling.'}>
<main data-main="1"><section><div class="wk_container"><div class="lg_header"><p class="v-eyebrow page_eyebrow" data-wk="eyebrow">Work</p><h1 class="intro_h1" data-wk="h1">Client work, live systems, public code.</h1><p class="art_lede" data-wk="lede">Case studies and our open-source tools, filtered by who the work was for and the network it runs on.{hasPosts && ' Switch to Articles for the writing that came out of them.'}</p></div><div class="wk_controls"><div class="wk_togglerow"><div aria-label="Type" class="wk_toggle" role="group"><button aria-pressed="true" class="wk_tab w-button" data-view="cases" type="button">Case studies</button>{hasPosts && <button aria-pressed="false" class="wk_tab w-button" data-view="articles" type="button">Articles</button>}</div><p class="tm_count" data-wk="count">{caseCount} items</p></div><div class="wk_filters"><div class="wk_filtergroup" data-wk="aud"><span class="cs_dt">For</span></div><div class="wk_filtergroup" data-wk="net"><span class="cs_dt">Network</span></div></div></div><div data-wk="cases"><WorkRows kind="cases" /></div><div data-wk="articles"><WorkRows kind="articles" /></div><div class="wk_empty" data-wk="empty"><p>Nothing public matches those filters yet.</p><a class="wk_clear w-button" data-wk="clear" href="#">Clear filters</a></div></div></section></main>
<script is:inline>
// Set the requested view before first paint (the Blog link opens /work?view=articles).
(function () {
  if (new URLSearchParams(location.search).get('view') !== 'articles') return;
  var c = document.querySelector('[data-wk="cases"]'), a = document.querySelector('[data-wk="articles"]');
  if (c) c.style.display = 'none';
  var set = function (k, v) { var el = document.querySelector('[data-wk="' + k + '"]'); if (el) el.textContent = v; };
  set('eyebrow', 'Blog');
  set('h1', 'Notes from the engineers.');
  set('lede', 'What we learned taking regulated assets, protocol integrations and developer tooling to mainnet. Switch to Case studies for the work itself.');
  if (a) set('count', a.querySelectorAll('.work_item').length + ' items');
})();
</script>
<Cta heading={'Working on something similar? Talk to an engineer.'} />
</BaseLayout>
