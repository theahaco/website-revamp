---
// Generated from the Webflow page "/contact". Edit freely: this file is the source now.
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
import Faces from '../components/Faces.astro';
// Without a form endpoint (contact.formEndpoint in src/data/site.ts) the form
// writes the message into the visitor's email app; the wording says so.
const viaEmail = !contact.formEndpoint;
---
<BaseLayout title={'Schedule a call with The Aha Company'} description={'Book a call with The Aha Company about regulated assets onchain, a protocol integration on Stellar, XRPL, Canton or EVM, or developer tooling for your ecosystem.'}>
<main class="contact_main"><div class="intro"><p class="v-eyebrow page_eyebrow">Contact</p><h1 class="intro_h1">Schedule a call.</h1><p class="text-lead">Thirty minutes with an engineer, not a sales team. Pick a slot, or send a note and we reply within one business day.</p><Faces /></div><div class="contact-grid"><section aria-label="Booking calendar" class="card calendar"><h2 class="card_h2">Pick a time</h2><p class="calendar_fallback">Calendar not showing? <a class="calendar_fallback-link" href="https://calendly.com/d/cs4b-dy3-9py/introduction-to-the-aha-company" rel="noopener" target="_blank">Open it in a new tab</a> or email <a class="calendar_fallback-link" href="mailto:hello@theaha.co">hello@theaha.co</a>.</p><div class="calendar_widget"><div class="w-embed"><iframe loading="lazy" src="https://calendly.com/d/cs4b-dy3-9py/introduction-to-the-aha-company?background_color=fbfaf8&amp;text_color=14243a&amp;primary_color=1a3b60&amp;embed_domain=theaha.co&amp;embed_type=Inline" style="width:100%;height:100%;border:0" title="Schedule a call with The Aha Company"></iframe></div></div></section><section aria-label="Contact form" class="card form-card"><h2 class="card_h2">Or send a note</h2><div class="w-form"><form action={contact.formEndpoint || undefined} class="form_form" data-mailto={contact.email} data-name="Email Form" data-subject="Website inquiry: Schedule a call" id="email-form" method="post" name="email-form"><input name="_source" type="hidden" value="theaha.co contact page"/><input name="_subject" type="hidden" value="Website inquiry: Schedule a call"/><input aria-hidden="true" autocomplete="off" name="_gotcha" style="display:none" tabindex="-1" type="text"/><div class="form_row"><div class="form_label"><label for="name">Name</label><input autocomplete="name" class="form_input w-input" data-name="Name" id="name" maxlength="256" name="name" placeholder="" required="" type="text"/></div><div class="form_label"><label for="email">Work email</label><input autocomplete="email" class="form_input w-input" data-name="Email" id="email" maxlength="256" name="email" placeholder="" required="" type="email"/></div></div><div class="form_row"><div class="form_label"><label for="company">Company</label><input autocomplete="organization" class="form_input w-input" data-name="Field" id="company" maxlength="256" name="company" placeholder="" type="text"/></div><div class="form_label"><label for="role">Role</label><input autocomplete="organization-title" class="form_input w-input" data-name="Field 2" id="role" maxlength="256" name="role" placeholder="" type="text"/></div></div><fieldset class="form_fieldset"><legend class="form_legend">I am</legend><div class="form_radio-group"><label class="form_radio-label"><label class="radio-wrap w-radio"><input class="w-form-formradioinput form_radio-input w-radio-input" data-name="audience" id="radio" name="audience" type="radio" value="institution"/><span class="w-form-label" for="radio">A financial institution</span></label></label><label class="form_radio-label"><label class="radio-wrap w-radio"><input class="w-form-formradioinput form_radio-input w-radio-input" data-name="audience" id="radio-2" name="audience" type="radio" value="protocol"/><span class="w-form-label" for="radio-2">A protocol or product expanding to a new network</span></label></label><label class="form_radio-label"><label class="radio-wrap w-radio"><input class="w-form-formradioinput form_radio-input w-radio-input" data-name="audience" id="radio-3" name="audience" type="radio" value="ecosystem"/><span class="w-form-label" for="radio-3">An ecosystem, foundation or Web3 team</span></label></label></div></fieldset><div class="form_label"><label for="message">Message</label><textarea class="form_textarea w-input" data-name="Field 3" id="message" maxlength="5000" name="message" placeholder="What are you trying to take to mainnet, and on which network?" rows="5"></textarea></div><input class="form_submit w-button" data-wait="Please wait..." type="submit" value={viaEmail ? 'Open in my email app' : 'Send message'}/></form><div class="form_success w-form-done" role="status" tabindex="-1"><div class="form_success-inner"><div class="form_success-dot"></div>{viaEmail ? <span>Your email app should open with this message: send it from there. Nothing opened? Copy the text above and send it to <a class="form_email-link" href={`mailto:${contact.email}`}>{contact.email}</a>.</span> : 'Sent. We reply within one business day.'}</div></div><div class="form_error w-form-fail" role="alert"><div>Your message did not go through. Email us at {contact.email}.</div></div><div class="form_email-line"><div class="inline-text">Or email </div><a class="form_email-link" href="mailto:hello@theaha.co">hello@theaha.co</a><div class="inline-text"> directly.</div></div></div></section></div></main>
</BaseLayout>
