---
// Network page template (Webflow collection "Networks"). A network without a
// heading has no page yet: its URL redirects to /networks, as on Webflow
// (Canton and Ethereum today).
// The visuals restate the network file and the case studies only:
// - "What the integration involves": the integration map of /services
//   (services/IntegrationMap.astro, wide), one card per item of `involves`
//   with its icon and description, the network's mark at the bottom.
// - XRPL, in the precedent: Ripple's programs as a flow, with only the facts
//   of src/content/case-studies/ripple.md.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Redirect from '../../layouts/Redirect.astro';
import Cta from '../../components/Cta.astro';
import Flow, { type FlowStep, type FlowFloat } from '../../components/vx/Flow.astro';
import IntegrationMap from '../../components/services/IntegrationMap.astro';
import { site as siteData } from '../../data/site';
import { networks, orderBy, publicQuote, nobr } from '../../lib/content';
import { otherNetworksOrder } from '../../data/curation';

export async function getStaticPaths() {
  return (await networks()).map((n) => ({ params: { slug: n.id }, props: { net: n } }));
}

const { net } = Astro.props;
const d = net.data;
const others = orderBy(await networks(), otherNetworksOrder).filter((n) => n.id !== net.id);
const q = publicQuote(d.proof.quote, !Astro.site || Astro.site.origin === siteData.productionOrigin);

// The softer second half of the "What the integration involves" title.
const involvesSoft: Record<string, string> = {
  stellar: 'Written for Stellar, not ported to it.',
  xrpl: 'The ledger’s built-in functions, wired to your systems.',
};
// The integration map: what the client brings on top (the same words for every
// network, from /services), one card per `involves` item (three columns when
// they make full rows of three, else two), the page's network at the bottom.
const mapNets = (['stellar', 'xrpl', 'canton', 'ethereum'] as const).filter((n) => n === net.id).map((n) => ({ net: n }));
const mapCols = Math.min(d.involves.length % 3 === 0 ? 3 : 2, d.involves.length);
// XRPL: how our architects work in Ripple's programs, from the Ripple case study.
const proofFlow: Record<string, { label: string; steps: FlowStep[]; floats: FlowFloat[] }> = {
  xrpl: {
    label: 'Ripple’s accelerator programs, from the case study: teams arrive with a prototype; our architects review the architecture, design the token and issuer, and help on the last steps; two teams in one 2026 cohort went live on mainnet or were ready to',
    steps: [
      { kind: 'anchor', logo: { src: '/images/logos/logo-light-ripple.svg', w: 44, h: 11 }, title: 'Ripple’s cohorts and hackathons', sub: 'A prototype and a deadline', tone: 'pink' },
      { kind: 'check', title: 'Architecture review of each design' },
      { kind: 'check', title: 'Token and issuer design' },
      { kind: 'check', title: 'Hands-on help before go live' },
      { kind: 'anchor', net: 'xrpl', title: 'Go live on XRPL', sub: '2 teams in one 2026 cohort, live or ready' },
    ],
    floats: [{ text: 'DevX audit of XRPL’s developer path, September 2026', icon: 'list-magnifying-glass', at: 'top' }],
  },
};
const flow = proofFlow[net.id];
---
{!d.heading ? (
  <Redirect to="/networks" title={`${d.name} | The Aha Company`} />
) : (
  <BaseLayout title={d.metaTitle || `Integrate with ${d.name} | The Aha Company`} description={d.description || d.lede || undefined}>
    <main data-main="1" data-nx="page">
      <section>
        <div class="nx_herowrap">
          <div class="nx_herogrid">
            <div class="nx_heroleft">
              <a class="art_back" data-back="1" href="/networks">← All networks</a>
              <div class="nx_eyebrowrow">
                <p class="v-eyebrow">Integrate with</p>
                {d.mark && <img alt={d.markAlt} class="nx_mark" src={d.mark} />}
              </div>
              <h1 class="intro_h1">{d.heading}{d.headingSoft && <> <span class="v-soft">{d.headingSoft}</span></>}</h1>
              {d.lede && <p class="art_lede" data-nx="lede">{d.lede}</p>}
              <div class="nf_actions">
                <a class="btn-primary" href="/contact">Schedule a call</a>
                {d.secondaryCta.label && <a class="btn-secondary" data-nx="cta2" href={d.secondaryCta.href}>{d.secondaryCta.label}</a>}
              </div>
              {d.stats.length > 0 && (
                <ul aria-label="Key figures" class={`nx_stats nx_stats--${d.stats.length}`} data-nx="stats" role="list">
                  {d.stats.map((s) => (
                    <li class="nxjs_stat"><span class:list={['nxjs_statv', !/\d/.test(s.value) && 'nxjs_statv--word']}>{s.value}</span><span class="nxjs_statl">{s.label}</span></li>
                  ))}
                </ul>
              )}
            </div>
            {d.ship.rows.length > 0 && (
              <div class="nx_shipcard" data-nx="shipcard">
                <div class="nx_shiphead">
                  <span class="nx_shiptitle" data-nx="shiptitle">{d.ship.title}</span>
                  <span class="nx_shipmeta" data-nx="shipmeta">{d.ship.meta}</span>
                </div>
                <div data-nx="shiprows">
                  {d.ship.rows.map((r) => (
                    <div class="nxjs_shiprow">
                      <div>{r.href ? <a class="nxjs_shipname nxjs_shiplink" href={r.href}>{r.name}&nbsp;<span aria-hidden="true">→</span></a> : <span class="nxjs_shipname">{r.name}</span>}<span class="nxjs_shipdesc">{r.description}</span></div>
                      {r.live ? (
                        <span class="nxjs_shipbadge"><span class="nxjs_shipdot" aria-hidden="true"></span>{r.badge}</span>
                      ) : (
                        <span class="nxjs_shipbadge nx_chip">{r.badge}</span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
      {d.involves.length > 0 && (
        <section aria-labelledby="nx-involves" class="ab_white" data-nx="involves-sec">
          <div class="ab_container">
            <div class="nxi" data-nx="involves">
              <h2 class="ab_h2 nxi_h2" id="nx-involves">What the integration involves.{involvesSoft[net.id] && <> <span class="v-soft" set:html={nobr(involvesSoft[net.id])} /></>}</h2>
              <IntegrationMap
                bottom={{ title: `On ${d.name}`, sub: 'Matched to the guarantees you already give users' }}
                cols={mapCols}
                label={`What an integration on ${d.name} involves: ${d.involves.map((r) => r.title).join(', ')}`}
                nets={mapNets}
                parts={d.involves.map((r) => ({ icon: r.icon || 'cube', title: r.title, sub: r.description }))}
                tint="blue"
                top={{ icon: 'plugs-connected', title: 'Your asset or protocol', sub: 'Live elsewhere, or launching for the first time' }}
                wide
              />
            </div>
          </div>
        </section>
      )}
      {d.steps.length > 0 && (
        <section class="nx_steps" data-nx="steps-sec">
          <div class="ab_container">
            <div class="ab_howhead">
              <h2 class="nx_h2light">How the integration runs</h2>
              {d.stepsLede && <p class="nx_stepslede" data-nx="stepslede">{d.stepsLede}</p>}
            </div>
            <ul class="nx_stepsgrid" data-nx="steps" role="list">
              {d.steps.map((s, i) => (
                <li class="nxjs_step">
                  <span class="nx_stephead"><span class="nxjs_stepnum">{i + 1}</span></span>
                  <h3 class="nxjs_steph3">{s.title}</h3>
                  <p class="nxjs_stepbody">{s.description}</p>
                  <p class="nxjs_stepout"><span style="font-weight:600">Output: </span>{s.output}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}
      {d.proof.heading && flow && (
        <section class="nx_proof nxp" data-nx="proof-sec">
          <div class="ab_container">
            <div class="nxp_row">
              <div class="nxp_text">
                {d.proof.eyebrow && <p class="cs_eyebrow" data-nx="proofeyebrow">{d.proof.eyebrow}</p>}
                <h2 class="ab_h2" data-nx="proofheading">{d.proof.heading}</h2>
                {d.proof.body && <p class="nxp_body" data-nx="proofbody">{d.proof.body}</p>}
                {q.text && (
                  <figure class="nxp_quote">
                    <p class="nx_quotetag" data-nx="quotetag" hidden={!q.label}>{q.label}</p>
                    <blockquote class="nxp_quotetext" data-nx="quote">{q.text}</blockquote>
                    <figcaption class="nx_quoteattr">
                      {q.portrait && <img alt={q.portraitAlt} class="nx_avatar" src={q.portrait} loading="lazy" />}
                      <div class="cs_namestack">
                        <p class="cs_teamname" data-nx="quotename">{q.author}</p>
                        <p class="tm_gridrole" data-nx="quoterole">{q.role}</p>
                      </div>
                      {q.logo && <img alt={q.logoAlt} class="nxp_quotelogo" src={q.logo} loading="lazy" />}
                    </figcaption>
                  </figure>
                )}
                <a class="svc_casecta" data-nx="prooflink" href={d.proof.caseStudy ? `/case-studies/${d.proof.caseStudy}` : '#'}>{d.proof.linkLabel || 'See the case study →'}</a>
              </div>
              <div class="nxp_visual">
                <Flow floats={flow.floats} label={flow.label} panel="blue" steps={flow.steps} />
              </div>
            </div>
          </div>
        </section>
      )}
      {d.proof.heading && !flow && (
        <section class="nx_proof" data-nx="proof-sec">
          <div class="ab_container">
            <div class="ab_howgrid">
              <div class="ab_howhead">
                {d.proof.eyebrow && <p class="cs_eyebrow" data-nx="proofeyebrow">{d.proof.eyebrow}</p>}
                <h2 class="ab_h2" data-nx="proofheading">{d.proof.heading}</h2>
                {d.proof.body && <p class="net_carddesc" data-nx="proofbody">{d.proof.body}</p>}
                <a class="svc_casecta" data-nx="prooflink" href={d.proof.caseStudy ? `/case-studies/${d.proof.caseStudy}` : '#'}>{d.proof.linkLabel || 'See the case study →'}</a>
              </div>
              {q.text && (
                <figure class="nx_quotecard">
                  <p class="nx_quotetag" data-nx="quotetag">{q.label}</p>
                  <blockquote class="nx_quote" data-nx="quote">{q.text}</blockquote>
                  <figcaption class="nx_quoteattr">
                    {q.portrait && <img alt={q.portraitAlt} class="nx_avatar" src={q.portrait} loading="lazy" />}
                    <div class="cs_namestack">
                      <p class="cs_teamname" data-nx="quotename">{q.author}</p>
                      <p class="tm_gridrole" data-nx="quoterole">{q.role}</p>
                    </div>
                  </figcaption>
                  {q.logo && <img alt={q.logoAlt} class="nx_quotelogo" src={q.logo} loading="lazy" />}
                </figure>
              )}
            </div>
          </div>
        </section>
      )}
      {d.funding.rows.length > 0 && (
        <section class="ab_white" data-nx="funding-sec">
          <div class="ab_container">
            <div class="ab_howgrid">
              <div class="ab_howhead">
                <h2 class="ab_h2" data-nx="fundingheading">{d.funding.heading}</h2>
                {d.funding.body && <p class="net_carddesc" data-nx="fundingbody">{d.funding.body}</p>}
              </div>
              <ul class="nx_fundinglist" data-nx="funding" role="list">
                {d.funding.rows.map((r) => (
                  <li class="nxjs_fundrow">
                    <div><span class="nxjs_fundname">{r.name}</span><span class="nxjs_funddesc">{r.description}</span></div>
                    <span class="nxjs_fundbadge">{r.badge}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )}
      {others.length > 0 && (
        <section class="footer_section" data-nx="othernets">
          <div class="ab_officescontainer">
            <div class="more_header">
              <h2 class="more_h2">Other networks</h2>
              <a class="more_all" href="/networks">All networks ↗</a>
            </div>
            <div class="w-dyn-list">
              <div class="net_cards w-dyn-items" role="list">
                {others.map((o) => (
                  <div class="w-dyn-item" role="listitem">
                    {o.data.heading ? (
                      <a class="net_card w-inline-block" href={`/networks/${o.id}`}>
                        {o.data.card.logo && <img alt={o.data.card.logoAlt} class="net_cardlogo" src={o.data.card.logo} loading="lazy" />}
                        <span class="net_cardname" data-on="name">{o.data.card.name}</span>
                        <span class="net_carddesc" data-on="line">{o.data.card.line}</span>
                      </a>
                    ) : (
                      <div class="net_card net_card--plain">
                        {o.data.card.logo && <img alt={o.data.card.logoAlt} class="net_cardlogo" src={o.data.card.logo} loading="lazy" />}
                        <span class="net_cardname" data-on="name">{o.data.name}</span>
                        <span class="net_carddesc" data-on="line">{o.data.card.line}</span>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      )}
    </main>
    <Cta heading={d.cta || 'Bring your institution or protocol onchain, with the team that builds the tooling.'} />
  </BaseLayout>
)}

<style>
  /* What the integration involves: the heading, then the integration map
     (services/IntegrationMap.astro), one card per item */
  .nxi { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 48px; }
  .nxi_h2 { max-width: 15em; margin: 0; text-wrap: balance; }
  .nxi_h2 .v-soft { display: block; }

  /* What we ship: the green dot only for what runs on mainnet; any other
     badge (a role, a beta, a demo) is a neutral chip */
  .nx_chip { height: 24px; padding: 0 9px; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--white); color: var(--ink-2); }

  /* A word among the key figures ("DevX") stays below the figures' size, on
     their baseline, as on the case pages */
  .nxjs_statv--word { align-items: flex-end; min-height: 31px; font-size: 22px; line-height: 1.1; letter-spacing: -.01em; }

  /* Precedent with a flow (XRPL): the case on one side, with its quote, the
     flow of the programs on the other */
  .nxp_row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 72px; row-gap: 48px; align-items: center; }
  .nxp_text { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; min-width: 0; }
  .nxp_body { margin: 0; max-width: 34em; color: var(--ink-2); font-size: 16px; line-height: 1.6; }
  .nxp_quote { display: flex; flex-direction: column; gap: 14px; margin: 8px 0 4px; padding: 22px 0 0; border-top: 1px solid var(--line-strong); }
  .nxp_quotetext { margin: 0; padding: 0; border: 0; background: none; color: var(--deep-blue); font-family: var(--font-display); font-size: 22px; font-style: italic; line-height: 1.35; }
  .nxp_quotelogo { width: auto; height: 18px; margin-left: auto; }
  .nxp_visual { min-width: 0; }

  /* The green eyebrow at AA contrast on the pink band of the precedent
     (#2f6e10, the green of the site's status pills: 5.1:1) */
  .nx_proof .cs_eyebrow { color: #2f6e10; }

  /* Three key figures in one row, never two and an orphan; on small phones,
     one per line, each figure beside its label */
  @media (min-width: 480px) { .nx_stats--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 479px) {
    .nx_stats--3 { grid-template-columns: minmax(0, 1fr); row-gap: 14px; }
    .nx_stats--3 .nxjs_stat { flex-direction: row; align-items: center; gap: 16px; }
    .nx_stats--3 .nxjs_statv { flex: 0 0 auto; min-width: 112px; white-space: nowrap; }
  }

  @media (max-width: 991px) {
    .nxp_row { grid-template-columns: minmax(0, 1fr); }
    .nxp_visual { max-width: 640px; }
  }
  @media (max-width: 767px) {
    .nxp_quotetext { font-size: 20px; }
  }
  /* Hero: one column under 1200 px, so the heading keeps to three lines */
  @media (max-width: 1199px) {
    .nx_herogrid { grid-template-columns: minmax(0, 1fr); }
    .nx_heroleft .intro_h1 { max-width: 18em; font-size: 56px; }
  }
  @media (max-width: 767px) { .nx_heroleft .intro_h1 { font-size: 42px; } }
  @media (max-width: 479px) { .nx_heroleft .intro_h1 { font-size: 34px; } }
</style>
