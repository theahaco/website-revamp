---
// /services: the three doors (financial institutions, protocols and products,
// ecosystems and foundations), each with its anchor (#institutions,
// #protocols, #ecosystems), where the home page's service rows link. Each
// door opens with a feature row (label, two-tone headline, lede, precedents
// and one visual), then the offer, how it runs and the tech
// (../components/services/). The visuals differ from the home page rows
// (the bank's settlement stablecoin, LI.FI, a Stellar CLI session): EURCV's
// compliance from launch to now, an integration mapped to the network, and
// three of our tools on their own sites.
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import DoorDetails, { type Item } from '../components/services/DoorDetails.astro';
import EurcvControls from '../components/services/EurcvControls.astro';
import IntegrationMap from '../components/services/IntegrationMap.astro';
import Precedents, { type PrecedentRow } from '../components/services/Precedents.astro';
import ToolPhones from '../components/services/ToolPhones.astro';

type DoorId = 'institutions' | 'protocols' | 'ecosystems';
interface Door {
  id: DoorId;
  tint: 'blue' | 'green' | 'pink';
  band: 'ab_white' | 'footer_section';
  label: string;
  title: string;
  soft: string;
  lede: string;
  /** Short name for the jump links in the header. */
  index: string;
  cases: PrecedentRow[];
  offer: Item[];
  steps: Item[];
  tech: string[];
  work: string;
}

const LOGOS = '/images/logos';
const doors: Door[] = [
  {
    id: 'institutions',
    tint: 'blue',
    band: 'ab_white',
    label: 'For financial institutions',
    title: 'Regulated assets onchain.',
    soft: 'With an operating model your risk committee signs off on.',
    lede: 'Stablecoins, tokenized funds and deposits, payment and settlement rails, with compliance controls on the asset or in contracts.',
    index: 'Regulated assets onchain',
    cases: [
      { href: '/case-studies/societe-generale-forge', name: 'Société Générale-FORGE', line: 'EURCV, a regulated euro stablecoin on Stellar', meta: 'Live since Q1 2026 · Issuance and governance', live: true, figure: { value: '€20M+', label: 'issued' }, logo: { src: `${LOGOS}/logo-light-sgforge.svg`, w: 77, h: 22 } },
      { href: '/case-studies/nda-settlement-stablecoin', rv: 'svc-bank', name: 'Top US commercial bank', line: 'An internal settlement stablecoin on Stellar', meta: 'Live since Q3 2026 · Architecture and delivery lead', live: true, figure: { value: '5 months', label: 'to handover' }, icon: 'lock-simple' },
      { href: '/case-studies/nda-money-market-fund', name: 'Regulated European asset manager', line: 'A tokenized share class of a money market fund', meta: 'In build on Stellar', icon: 'lock-simple' },
    ],
    offer: [
      { title: 'Stablecoin issuance and governance', desc: 'Role separation, freeze and clawback, allow and deny lists.' },
      { title: 'Tokenized funds and deposits', desc: 'Mapped to the legal structure.' },
      { title: 'Payment and settlement rails', desc: 'With mint and burn bridges to core banking.' },
      { title: 'Custody and keys', desc: 'Custodian and MPC integrations, KYT through the custodian.' },
    ],
    steps: [
      { title: 'Scoping', desc: 'One technical session on authorities, custody, compliance controls and core banking.' },
      { title: 'Structure', desc: 'NDA, then an MOU: fixed scope, dated milestones, acceptance by your team.' },
      { title: 'Build', desc: 'Two or three use cases first, on testnet with your operations team.' },
      { title: 'Mainnet and after', desc: 'An independent audit, mainnet, then handover; we stay on.' },
    ],
    tech: ['Soroban', 'Stellar Asset Contract', 'SEP-41', 'XRPL MPT', 'Freeze and clawback', 'Custody and MPC', 'KYT', 'Core banking integration'],
    work: '/work?for=institutions',
  },
  {
    id: 'protocols',
    tint: 'green',
    band: 'footer_section',
    label: 'For protocols and products',
    title: 'Protocol and product integration.',
    soft: 'Written for the network, not ported to it.',
    lede: 'Your protocol or product on Stellar, XRPL, Canton or EVM, live elsewhere or launching for the first time: native contracts, adapters and SDKs, routing and liquidity, matched to the guarantees you already give users.',
    index: 'Protocol and product integration',
    cases: [
      { href: '/case-studies/lifi', name: 'LI.FI', line: 'Soroban contracts behind the Stellar integration', meta: 'Live on Stellar · Audited by Halborn', live: true, logo: { src: `${LOGOS}/logo-light-lifi.svg`, w: 55, h: 20 } },
      { href: '/case-studies/talwex', name: 'Talwex', line: 'Soroban smart contracts for an institutional bond yield pool', meta: 'In build on Stellar', logo: { src: `${LOGOS}/logo-talwex-mark.svg`, w: 30, h: 20 } },
    ],
    offer: [
      { title: 'Integration roadmap', desc: 'Your integration surface mapped to the target network.' },
      { title: 'Native contracts', desc: 'Written for the network rather than ported.' },
      { title: 'Adapters and SDKs', desc: 'A typed client for your existing stack.' },
      { title: 'Routing and liquidity', desc: 'Bridges, exchanges and liquidity plans.' },
    ],
    steps: [
      { title: 'Roadmap', desc: 'Your product mapped to the network, with the guarantees you give users.' },
      { title: 'Proposal', desc: 'Fixed scope and dated milestones, with or without an ecosystem program.' },
      { title: 'Build', desc: 'Native contracts, adapters and SDKs, on testnet first.' },
      { title: 'Mainnet', desc: 'An independent audit and its fixes, launch, docs and handover.' },
    ],
    tech: ['Soroban', 'Rust', 'TypeScript', 'Stellar Asset Contract', 'Circle CCTP', 'Cross-chain routing', 'Wallet kits', 'Third-party audits'],
    work: '/work?for=protocols',
  },
  {
    id: 'ecosystems',
    tint: 'pink',
    band: 'ab_white',
    label: 'For ecosystems and foundations',
    title: 'Developer tooling and DevX.',
    soft: 'Built and maintained as public goods.',
    lede: 'The tooling an ecosystem runs on, and the programs that take teams from prototype to go live.',
    index: 'Developer tooling and DevX',
    cases: [
      { href: '/case-studies/stellar-development-foundation', name: 'Stellar Development Foundation', line: 'Stellar Scaffold, Stellar CLI plugin system, Stellar Registry, Nido', meta: 'Stellar · 2021-today', logo: { src: `${LOGOS}/logo-light-stellar.svg`, w: 77, h: 19 } },
      { href: '/case-studies/ripple', name: 'Ripple', line: 'Accelerator cohorts, hackathons and a two-week DevX audit of XRPL’s developer path', meta: 'XRPL · Since Q4 2025', logo: { src: `${LOGOS}/logo-light-ripple.svg`, w: 70, h: 18 } },
      { href: '/case-studies/starknet', name: 'Starknet', line: 'A DevX audit of the developer onboarding: two engineers, one week, three documents', meta: 'Starknet · DevX audit', logo: { src: `${LOGOS}/logo-light-starknet.svg`, w: 78, h: 18 } },
      { href: '/open-source', rv: 'svc-tools', name: 'Open source', line: 'Each tool has its own page: Stellar CLI, Stellar Scaffold, Stellar Registry, Nido, Perch, Moonlight, Tansu and GhostSig', meta: 'Stellar and XRPL', icon: 'terminal-window' },
    ],
    offer: [
      { title: 'DevX audit', desc: 'Two senior engineers, two weeks full time, on your real onboarding path.' },
      { title: 'Tooling roadmap', desc: 'Agreed with the ecosystem’s engineering team.' },
      { title: 'Open-source tooling', desc: 'CLIs, scaffolding, registries, sandboxes and wallets, built as public goods.' },
      { title: 'Accelerator and hackathon mentoring', desc: 'Architecture reviews, token and issuer design, hands-on help on the path to go live.' },
    ],
    steps: [
      { title: 'DevX audit', desc: 'Ranked findings on your onboarding path, small fixes as pull requests.' },
      { title: 'Roadmap', desc: 'Priorities agreed on the findings, each item a project with milestones.' },
      { title: 'Build', desc: 'Open-source tools with their docs, milestone by milestone.' },
      { title: 'Maintain', desc: 'A quarterly public-goods proposal and review.' },
    ],
    tech: ['Rust', 'TypeScript', 'CLI plugins', 'Code generation', 'Passkeys', 'Open source', 'SBOMs', 'Release automation'],
    work: '/work?for=ecosystems',
  },
];
---
<BaseLayout title={'Stablecoin and tokenization services | The Aha Company'} description={'Stablecoin issuance, tokenized funds and deposits for banks, integrations for protocols moving to a new network, and developer tooling for ecosystems.'}>
<main data-main="1">
  <section class="sv-hero">
    <div class="svc_introcontainer sv-herobox">
      <div class="lg_header sv-herotext">
        <p class="v-eyebrow page_eyebrow">Services</p>
        <h1 class="intro_h1 sv-h1">Three doors, <span class="v-soft">one engineering team.</span></h1>
        <p class="art_lede">Regulated assets onchain for financial institutions. Integrations for protocols and products expanding to a new network. Developer tooling for the ecosystems themselves. The engineers who build the networks’ tooling do the integrations.</p>
      </div>
      <nav aria-label="Sections" class="sv-index">
        <ol class="sv-indexlist" role="list">
          {doors.map((d, i) => (
            <li class="sv-indexitem">
              <a class="sv-indexlink" href={`#${d.id}`}>
                <span aria-hidden="true" class="sv-indexnum">{String(i + 1).padStart(2, '0')}</span>
                <span class="sv-indexlabel">{d.label}</span>
                <span class="sv-indexdesc">{d.index}</span>
                <span aria-hidden="true" class="sv-indexarrow">↓</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  {doors.map((d, i) => (
    <section aria-labelledby={`${d.id}-title`} class:list={[d.band, 'sv-door', `sv-door--${d.id}`]} id={d.id}>
      <div class="sv-doorbox">
        <div class:list={['sv-feature', i % 2 === 1 && 'sv-feature--flip']}>
          <div class="sv-text">
            <p class="v-eyebrow">{d.label}</p>
            <h2 class="sv-h2" id={`${d.id}-title`}>{d.title} <span class="v-soft">{d.soft}</span></h2>
            <p class="sv-lede">{d.lede}</p>
            <Precedents rows={d.cases} tint={d.tint} />
          </div>
          <div class="sv-visual">
            {d.id === 'institutions' && <EurcvControls />}
            {d.id === 'protocols' && <IntegrationMap />}
            {d.id === 'ecosystems' && <ToolPhones />}
          </div>
        </div>
        <DoorDetails id={d.id} offer={d.offer} steps={d.steps} tech={d.tech} work={d.work} />
      </div>
    </section>
  ))}
</main>
<Cta heading={'Which door is yours? Thirty minutes with an engineer settles it.'} />
</BaseLayout>

<style>
  /* Header: the title in two tones; the three doors as numbered links,
     beside it on wide screens, under it below 992 px */
  .sv-herobox { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: 64px; align-items: end; }
  .sv-herotext { max-width: 700px; }
  .sv-h1 { font-size: clamp(44px, 4.6vw, 64px); }
  .sv-h1 .v-soft { display: block; }
  .sv-index { width: 100%; }
  .sv-indexlist { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .sv-indexitem { display: flex; min-width: 0; border-bottom: 1px solid var(--line); }
  .sv-indexlink { position: relative; display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; grid-template-areas: 'num label arrow' 'num desc arrow'; column-gap: 12px; row-gap: 3px; align-items: start; width: 100%; padding: 18px 4px 18px 0; color: inherit; text-decoration: none; }
  .sv-indexlink:focus-visible { outline: 2px solid var(--green-ink); outline-offset: 2px; border-radius: 6px; }
  .sv-indexnum { grid-area: num; padding-top: 5px; color: var(--muted); font-size: 13px; font-weight: 500; line-height: 1; }
  .sv-indexlabel { grid-area: label; color: var(--deep-blue); font-size: 18px; font-weight: 600; line-height: 1.3; transition: color .2s; }
  .sv-indexdesc { grid-area: desc; color: var(--ink-2); font-size: 15px; line-height: 1.45; }
  .sv-indexarrow { grid-area: arrow; align-self: center; color: var(--muted); font-size: 18px; line-height: 1; transition: color .2s, transform .2s; }
  .sv-indexlink:hover .sv-indexlabel { color: var(--green-ink); }
  .sv-indexlink:hover .sv-indexarrow { color: var(--green-ink); transform: translateY(3px); }
  @media (prefers-reduced-motion: reduce) { .sv-indexlabel, .sv-indexarrow { transition: none; } .sv-indexlink:hover .sv-indexarrow { transform: none; } }

  /* Each door: a feature row (text and one visual, switching sides), then
     the details on hairline rules */
  .sv-doorbox { display: flex; flex-direction: column; gap: 72px; max-width: var(--container); margin: 0 auto; padding: clamp(72px, 8.5vw, 120px) clamp(24px, 4vw, 48px); }
  /* On wide screens the visual's panel takes the height of the text beside
     it, the product UI centred in it */
  .sv-feature { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: 64px; align-items: stretch; }
  .sv-feature--flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .sv-feature--flip .sv-text { order: 2; }
  .sv-text { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .sv-h2 { margin: 20px 0 20px; color: var(--deep-blue); font-family: var(--font-display); font-size: clamp(30px, 2.9vw, 38px); font-style: italic; font-weight: 400; line-height: 1.14; letter-spacing: -.01em; text-wrap: balance; }
  .sv-h2 .v-soft { display: block; }
  .sv-lede { margin: 0 0 32px; max-width: 34em; color: var(--ink-2); font-size: 17px; line-height: 1.55; text-wrap: pretty; }
  .sv-visual { display: flex; flex-direction: column; min-width: 0; }
  .sv-visual > :global(*) { flex: 1 1 auto; }

  @media (pointer: coarse) { .sv-indexlink { min-height: 44px; } }
  @media (max-width: 1199px) {
    .sv-herobox { column-gap: 48px; }
    .sv-feature { column-gap: 48px; }
    /* The phones keep their own height when the text beside them runs long */
    .sv-door--ecosystems .sv-visual { align-self: center; }
  }
  @media (max-width: 991px) {
    .sv-herobox { grid-template-columns: minmax(0, 1fr); row-gap: 44px; }
    .sv-h1 { font-size: 50px; }
    .sv-index { max-width: 640px; }
    .sv-feature, .sv-feature--flip { grid-template-columns: minmax(0, 1fr); row-gap: 48px; }
    .sv-feature--flip .sv-text { order: 0; }
    .sv-visual { width: 100%; }
    .sv-doorbox { gap: 56px; }
  }
  @media (max-width: 767px) {
    .sv-h1 { font-size: 40px; }
    .sv-indexlink { grid-template-columns: 28px minmax(0, 1fr) auto; padding: 16px 0; }
    .sv-indexnum { padding-top: 4px; }
    .sv-indexlabel { font-size: 17px; }
    .sv-h2 { margin: 18px 0 16px; }
    .sv-lede { margin-bottom: 28px; font-size: 16px; }
    .sv-doorbox { gap: 48px; }
  }
  /* Small phones: the soft half of the title on one line */
  @media (max-width: 479px) {
    .sv-h1 { font-size: 35px; }
  }
  @media (max-width: 359px) { .sv-h1 { font-size: 30px; } }
</style>
