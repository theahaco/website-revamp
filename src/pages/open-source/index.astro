---
// Open-source index: the home band's recipe for the header (eyebrow, two-tone
// title, one short lede and three phones showing our tools' real sites, cut
// by the top rule of the figures), then one card per tool (each tool has its
// own page, src/content/tools), the counting rules and the standards and
// other contributions (src/data/opensource.ts). The phones differ from the
// home band's: Moonlight in front. The tool tiles follow the home band's cells
// (icon box, corner arrow), one white tile each on the paper band, with the
// headline figure in a small tile. The counting rules and the contributions
// are records, as the home hero's proof card: the rules for project counts in
// a card on a pink panel (the rules for every figure beside it), the
// contributions in one registry card (src/components/vx/Registry.astro).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import PhoneStack from '../../components/vx/PhoneStack.astro';
import Registry from '../../components/vx/Registry.astro';
import Icon from '../../components/Icon.astro';
import NetMark from '../../components/home/NetMark.astro';
import { toolIcons } from '../../lib/toolIcons';
import { contributions } from '../../data/opensource';
import { tools } from '../../lib/content';
import { site, toolAdoption } from '../../data/site';

const list = await tools();
// The network marks for a tool's network field ("Stellar", "XRPL and Stellar").
const netIds: Record<string, 'stellar' | 'xrpl' | 'canton' | 'ethereum'> = { stellar: 'stellar', xrpl: 'xrpl', canton: 'canton', ethereum: 'ethereum' };
const netsOf = (s: string) => s.split(/ and |, /).map((n) => netIds[n.trim().toLowerCase()]).filter(Boolean);
const metrics = [
  { figure: String(toolAdoption.count), label: `Projects using at least one of our tools (${toolAdoption.date})`, receipt: '' },
  { figure: '~20%', label: 'Of Stellar CLI commits, 2022 to 2025', receipt: 'https://github.com/stellar/stellar-cli' },
  { figure: '125,107', label: 'Downloads of our Stellar crates since 2023 (November 2, 2026)', receipt: '' },
  { figure: '~$1.4M', label: 'Public goods funding the Stellar Community Fund voted on Tansu, Q2 to Q4 2026', receipt: 'https://app.tansu.dev' },
];
// How we count: the eleven rules of the page, sorted. The rules for every
// figure sit beside the title (the date it was counted is the title's second
// line); the card holds the rules for project counts, under its verdicts (a
// check: counts; 1: counts once; a cross: does not count), floors in its foot.
const countFacts = [
  { icon: 'calendar-check', title: 'Counts that only grow are as of that date', sub: 'Such as downloads, calls and wallets' },
  { icon: 'check-square-offset', title: 'Testnet counts include our own testing' },
];
const countRules: { label?: string; mark: 'yes' | 'once' | 'no'; rows: { title: string; sub?: string }[] }[] = [
  { mark: 'yes', rows: [{ title: 'Its public repo uses a tool in code', sub: 'Configuration, dependencies, imports or CLI scripts' }, { title: 'Its contracts use it onchain' }] },
  { label: 'Counts once', mark: 'once', rows: [{ title: 'Forks' }, { title: 'A project using several tools, in the total' }] },
  { label: 'Counts like any other project', mark: 'yes', rows: [{ title: 'Our other tools and our team’s own projects' }] },
  { label: 'Does not count', mark: 'no', rows: [{ title: 'A tool’s own repo, toward that tool' }, { title: 'Pages that only mention a tool' }] },
];
const siteUrl = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : site.productionOrigin;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Open-source tools by The Aha Company',
  itemListElement: list.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.data.name, url: new URL(`open-source/${t.id}/`, siteUrl).href })),
};
---
<BaseLayout title="Open-source Stellar and XRPL tools | The Aha Company" description="Open-source Stellar and XRPL tools we build and maintain, one page per tool: Stellar CLI, Stellar Scaffold, Stellar Registry, Nido, Perch, Moonlight, Tansu.">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} /></Fragment>
  <main data-main="1" data-os="page">
    <section aria-labelledby="osh-title" class="osh">
      <div class="osh_inner">
        <div class="osh_top">
          <div class="osh_text">
            <p class="v-eyebrow">Open source</p>
            <h1 class="osh_h1" id="osh-title">Public code you can inspect, <span class="v-soft">commit by commit.</span></h1>
            <p class="osh_lede" data-os="lede">The tooling behind our work is open source. On Stellar we are core contributors to the official CLI and build the tools around it; some of them already serve XRPL. Each tool has its own page, with every figure dated.</p>
            <p class="osh_case">Foundations hire us to build and maintain them. <a class="osh_caselink" href="/case-studies/stellar-development-foundation">The Stellar Development Foundation case <span aria-hidden="true">→</span></a></p>
          </div>
          <div class="osh_visual">
            <div class="osh_stage">
              <PhoneStack center="moonlight" lazy={false} left="nido" right="stellar-registry" sizes="(min-width: 1200px) 217px, (min-width: 992px) 19vw, (min-width: 600px) 210px, 33vw" />
            </div>
          </div>
        </div>
        <section aria-label="In numbers" class="osh_figures" data-os="metrics">
          <ul class="cs_metrics osh_metrics" role="list">
            {metrics.map((m) => (
              <li class="cs_metric">
                <span class="cs_fig"><span>{m.figure}</span>{m.receipt && <a aria-label={`Receipt: ${m.label}`} class="cs_figmark" href={m.receipt}>✓</a>}</span>
                <span class="cs_metriclabel">{m.label}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>
    <section class="ab_white os_tools" aria-labelledby="os-tools-title">
      <div class="ab_container">
        <div class="os_toolshead">
          <p class="v-eyebrow">Tools</p>
          <h2 class="ab_h2" id="os-tools-title">The tools <span class="v-soft">we build and maintain.</span></h2>
        </div>
        <ul class="os_grid" data-os="tools" role="list">
          {list.map((t) => (
            <li class="os_card" id={t.id} data-os-tool={t.id}>
              <a class="os_cardlink" href={`/open-source/${t.id}`}>
                <span class="os_top">
                  <span class="v-iconbox v-iconbox--pink"><Icon name={toolIcons[t.id] ?? 'code'} size={26} /></span>
                  <span aria-hidden="true" class="os_arrow">↗</span>
                </span>
                <span class="os_name">{t.data.name}</span>
                <span class="os_meta">
                  <span class="os_cat">{t.data.category}</span>
                  <span class="os_net">{netsOf(t.data.network).map((n) => <NetMark net={n} size={12} lazy />)}{t.data.network}</span>
                </span>
                <span class="os_what">{t.data.summary}</span>
                {t.data.headline?.figure && (
                  <span class="os_kpi"><span class="os_kpifig">{t.data.headline.figure}</span><span class="os_kpilabel">{t.data.headline.label}</span></span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section aria-labelledby="os-count-title" class="ab_white" data-os="count" id="how-we-count">
      <div class="ab_container">
        <div class="osc">
          <div class="osc_head">
            <p class="v-eyebrow">In numbers</p>
            <h2 class="ab_h2 osc_h2" id="os-count-title">How we count. <span class="v-soft">Every figure carries the date it was counted.</span></h2>
            <ul class="osc_facts" role="list">
              {countFacts.map((f) => (
                <li class="osc_fact"><span class="v-iconbox v-iconbox--sm"><Icon name={f.icon} size={20} /></span><span class="osc_ftext"><span class="osc_ftitle">{f.title}</span>{f.sub && <span class="osc_fsub">{f.sub}</span>}</span></li>
              ))}
            </ul>
          </div>
          <div class="osc_panel">
            <div class="osc_card">
              <p class="osc_cardhead" id="os-count-when">A project counts when</p>
              {countRules.map((g, i) => (
                <div class="osc_group">
                  {g.label && <p class="osc_glabel" id={`os-count-${i}`}>{g.label}</p>}
                  <ul aria-labelledby={g.label ? `os-count-${i}` : 'os-count-when'} class="osc_rules" role="list">
                    {g.rows.map((r) => (
                      <li class="osc_rule">
                        <span aria-hidden="true" class:list={['osc_mark', `osc_mark--${g.mark}`]}>
                          {g.mark === 'yes' && <svg fill="none" height="14" viewBox="0 0 14 14" width="14"><path d="M2.5 7.4 5.6 10.3 11.5 3.9" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>}
                          {g.mark === 'once' && '1'}
                          {g.mark === 'no' && <svg fill="none" height="12" viewBox="0 0 12 12" width="12"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-linecap="round" stroke-width="1.9" /></svg>}
                        </span>
                        <span class="osc_rtext"><span class="osc_rtitle">{r.title}</span>{r.sub && <span class="osc_rsub">{r.sub}</span>}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <p class="osc_foot"><span class="v-iconbox v-iconbox--sm osc_footicon"><Icon name="magnifying-glass" size={20} /></span><span class="osc_ftext"><span class="osc_ftitle">Project counts are floors</span><span class="osc_fsub">Code search does not index every repo</span></span></p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section aria-labelledby="os-st-title" data-os="contributions">
      <div class="ab_container">
        <div class="os_toolshead">
          <p class="v-eyebrow">Beyond our own tools</p>
          <h2 class="ab_h2 osr_h2" id="os-st-title">Standards and contributions. <span class="v-soft">Across the networks we work on.</span></h2>
        </div>
        <Registry data-os="standards" groups={contributions} />
      </div>
    </section>
  </main>
  <Cta heading="Building on Stellar or XRPL? Talk to the engineers who write the tooling." />
</BaseLayout>
<style>
  /* Header: text and phones side by side, the deep-blue panel of the phones
     standing on the top rule of the figures (as the team photo stands on the
     row of models in "Ways to work with us") */
  .osh_inner { width: 100%; max-width: 1200px; margin: 0 auto; padding: clamp(56px, 7vw, 96px) clamp(24px, 4vw, 48px) 0; }
  .osh_top { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 64px; align-items: end; }
  .osh_text { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; padding-bottom: 48px; }
  .osh_h1 { margin: 0; max-width: 11em; color: var(--deep-blue); font-family: var(--font-display); font-size: 58px; font-style: italic; font-weight: 400; line-height: 1.07; letter-spacing: -.015em; text-wrap: balance; }
  .osh_h1 .v-soft { display: block; }
  .osh_lede { margin: 0; max-width: 33em; color: var(--ink-2); font-size: 18px; line-height: 1.55; text-wrap: pretty; }
  .osh_case { margin: 0; max-width: 33em; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .osh_caselink { color: var(--deep-blue); font-weight: 600; text-decoration: none; transition: color .2s; }
  .osh_caselink:hover { color: var(--green-ink); }
  /* The stage is sized by the panel's height, so the phones keep their place
     whatever the panel's proportions; the panel cuts them at the bottom */
  .osh_visual { position: relative; overflow: hidden; margin-bottom: -1px; aspect-ratio: 1.18; border-radius: 20px 20px 0 0; background: var(--deep-blue); }
  .osh_stage { position: absolute; bottom: 0; left: 50%; height: 88%; aspect-ratio: 1.22; transform: translateX(-50%); }
  .osh_metrics { border-bottom: 0; }

  @media (max-width: 1199px) {
    .osh_top { column-gap: 48px; }
    .osh_h1 { font-size: 48px; }
  }
  @media (max-width: 991px) {
    .osh_top { grid-template-columns: minmax(0, 1fr); }
    .osh_metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .osh_text { padding-bottom: 40px; }
    .osh_h1 { max-width: 13em; }
    .osh_visual { aspect-ratio: 1.55; }
  }
  @media (max-width: 767px) {
    .osh_h1 { font-size: 40px; }
    .osh_lede { font-size: 17px; }
    .osh_metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 20px; row-gap: 28px; }
  }
  @media (max-width: 599px) {
    .osh_visual { aspect-ratio: 1.2; border-radius: 16px 16px 0 0; }
  }
  @media (max-width: 379px) {
    .osh_h1 { font-size: 34px; }
  }
  @media (pointer: coarse) {
    .osh_caselink { display: inline-flex; align-items: center; min-height: 44px; }
  }

  /* The tools: white tiles on the paper band, as the home band's cells */
  .os_tools { background: var(--paper); }
  .os_toolshead { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .os_grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 1200px) { .os_grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .os_card { display: flex; min-width: 0; scroll-margin-top: 120px; }
  .os_cardlink { display: flex; flex-direction: column; gap: 10px; width: 100%; padding: 24px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); color: inherit; text-decoration: none; transition: border-color .2s, box-shadow .2s; }
  .os_cardlink:hover { border-color: var(--line-strong); box-shadow: var(--shadow-1); }
  .os_top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .os_arrow { font-size: 18px; line-height: 1; color: var(--muted-2); transition: color .2s, transform .2s; }
  .os_cardlink:hover .os_arrow { color: var(--green-ink); transform: translate(2px, -2px); }
  .os_name { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 26px; line-height: 1.15; color: var(--deep-blue); }
  .os_meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .os_cat { font-size: 14px; line-height: 1.4; color: var(--muted); }
  .os_net { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px 3px 7px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink-2); font-size: 12px; font-weight: 500; line-height: 1.3; white-space: nowrap; }
  .os_what { margin-bottom: 8px; font-size: 15px; line-height: 1.5; color: var(--ink-2); text-wrap: pretty; }
  .os_kpi { display: flex; flex-direction: column; gap: 3px; margin-top: auto; padding: 12px 14px; border-radius: 12px; background: var(--tint-pink); }
  .os_kpifig { color: var(--deep-blue); font-size: 24px; font-weight: 600; letter-spacing: -.02em; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .os_kpilabel { color: var(--ink-2); font-size: 13px; line-height: 1.35; }
  @media (prefers-reduced-motion: reduce) { .os_arrow { transition: none; } .os_cardlink:hover .os_arrow { transform: none; } }
  /* Phones: compact tiles, the icon beside the name, the figure on one line */
  @media (max-width: 599px) {
    .os_grid { gap: 12px; }
    .os_cardlink { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: 14px; row-gap: 4px; align-items: center; padding: 18px 18px 18px 16px; }
    .os_top { display: contents; }
    .os_top .v-iconbox { grid-column: 1; grid-row: 1 / span 2; width: 40px; height: 40px; border-radius: 10px; }
    .os_top .v-iconbox :global(svg) { width: 22px; height: 22px; }
    .os_arrow { position: absolute; top: 16px; right: 16px; font-size: 16px; }
    .os_name { grid-column: 2; padding-right: 24px; font-size: 22px; }
    .os_meta { grid-column: 2; }
    .os_what { grid-column: 1 / -1; margin: 8px 0 6px; }
    .os_kpi { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: baseline; column-gap: 10px; padding: 10px 12px; }
    .os_kpifig { font-size: 20px; }
  }
  /* How we count: the rules for every figure beside the title, the rules for
     project counts as a proof card (the home hero's: a deep blue head, rows,
     a foot on the blue tint) on a pink panel, as the Selected work visuals */
  .osc { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 64px; align-items: center; }
  .osc_head { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; min-width: 0; }
  .osc_h2 { max-width: 12em; text-wrap: balance; }
  .osc_h2 .v-soft, .osr_h2 .v-soft { display: block; }
  .osr_h2 { text-wrap: balance; }
  .osc_facts { width: 100%; margin: 16px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .osc_fact { display: grid; grid-template-columns: 36px minmax(0, 1fr); column-gap: 14px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .osc_ftext { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .osc_ftitle { color: var(--deep-blue); font-size: 15px; font-weight: 600; line-height: 1.35; text-wrap: balance; }
  .osc_fsub { color: var(--muted); font-size: 14px; line-height: 1.4; }
  .osc_panel { display: grid; place-items: center; min-width: 0; padding: 36px; border: 1px solid var(--line); border-radius: 20px; background: var(--tint-pink); }
  .osc_card { width: 100%; max-width: 460px; overflow: hidden; border: 1px solid var(--line-strong); border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--shadow-2); }
  .osc_cardhead { margin: 0; padding: 14px 20px; background: var(--deep-blue); color: var(--white); font-family: var(--font-display); font-size: 21px; font-style: italic; line-height: 1.2; }
  .osc_group + .osc_group { border-top: 1px solid var(--line); }
  .osc_glabel { margin: 0; padding: 14px 20px 2px; color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .08em; line-height: 1.4; text-transform: uppercase; }
  .osc_rules { margin: 0; padding: 5px 0; list-style: none; }
  .osc_rule { display: grid; grid-template-columns: 24px minmax(0, 1fr); column-gap: 12px; align-items: center; padding: 6px 20px; }
  /* The verdicts: Flow's check, 1 for once, a cross */
  .osc_mark { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; }
  .osc_mark--yes { background: var(--vibrant-green); color: var(--white); }
  .osc_mark--once { background: var(--deep-blue); color: var(--white); font-size: 12px; font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .osc_mark--no { background: var(--tint-tan); color: var(--ink-2); }
  .osc_rtext { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .osc_rtitle { color: var(--ink); font-size: 15px; font-weight: 500; line-height: 1.35; }
  .osc_rsub { color: var(--muted); font-size: 13px; line-height: 1.4; }
  .osc_foot { display: flex; align-items: center; gap: 14px; margin: 0; padding: 14px 20px 15px; border-top: 1px solid var(--line-strong); background: var(--tint-blue); }
  .osc_footicon { background: var(--white); }
  @media (max-width: 1199px) {
    .osc { column-gap: 48px; }
  }
  @media (max-width: 991px) {
    .osc { grid-template-columns: minmax(0, 1fr); row-gap: 40px; }
  }
  @media (max-width: 767px) {
    .osc_panel { padding: 28px 12px; }
    .osc_cardhead { padding: 13px 16px; font-size: 20px; }
    .osc_glabel { padding: 12px 16px 2px; }
    .osc_rule { padding: 7px 16px; }
    .osc_foot { padding: 14px 16px 15px; }
  }

  /* Unused since the proof cards (November 2026): the counting text and the standards lists they replaced */
  .os_count { display: flex; flex-direction: column; gap: 14px; max-width: 640px; font-size: 16px; line-height: 1.6; color: var(--ink-2); }
  .os_count p { margin: 0; }
  .os_sthead { display: flex; flex-direction: column; gap: 16px; max-width: 720px; }
  .os_stlede { margin: 0; font-size: 17px; line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
  .os_stgroups { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 48px; }
  .os_stlabel { margin: 0; padding-bottom: 12px; border-bottom: 1px solid var(--deep-blue); font-family: inherit; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--deep-blue); }
  .os_stlist { margin: 0; padding: 0; list-style: none; }
  .os_stitem { display: flex; flex-direction: column; gap: 6px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .os_stmeta { order: -1; margin: 0; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .os_ststatus { color: var(--green-ink); }
  .os_stname { margin: 0; font-size: 18px; font-weight: 600; line-height: 1.35; color: var(--deep-blue); text-decoration: none; }
  a.os_stname:hover { color: var(--green-ink); }
  .os_starrow { color: var(--muted); font-weight: 500; }
  .os_stwhat { margin: 0; font-size: 16px; line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
  @media (min-width: 992px) {
    .os_stgroups { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 64px; }
    .os_stgroup:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .os_stgroup:last-child:nth-child(odd) .os_stlist { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 64px; }
  }
</style>
