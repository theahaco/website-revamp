---
// Open-source index: the figures across our tools, one card per tool
// (each tool has its own page, src/content/tools), the counting rules and
// the standards and other contributions (src/data/opensource.ts).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import { contributions } from '../../data/opensource';
import { tools, nobr } from '../../lib/content';
import { site, toolAdoption } from '../../data/site';

const list = await tools();
const metrics = [
  { figure: String(toolAdoption.count), label: `Projects using at least one of our tools (${toolAdoption.date})`, receipt: '' },
  { figure: '~20%', label: 'Of Stellar CLI commits, 2022 to 2025', receipt: 'https://github.com/stellar/stellar-cli' },
  { figure: '125,107', label: 'Downloads of our Stellar crates since 2023 (November 2, 2026)', receipt: '' },
  { figure: '~$1.4M', label: 'Public goods funding the Stellar Community Fund voted on Tansu, Q2 to Q4 2026', receipt: 'https://app.tansu.dev' },
];
const siteUrl = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : site.productionOrigin;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Open-source tools by The Aha Company',
  itemListElement: list.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.data.name, url: new URL(`open-source/${t.id}/`, siteUrl).href })),
};
---
<BaseLayout title="Open-source Stellar and XRPL tools | The Aha Company" description="Open-source Stellar and XRPL tools we build and maintain, one page per tool: Stellar CLI, Stellar Scaffold, Stellar Registry, Nido, Perch, Moonlight, Tansu.">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} /></Fragment>
  <main data-main="1" data-os="page">
    <section>
      <div class="svc_introcontainer">
        <div class="lg_header">
          <p class="v-eyebrow page_eyebrow">Open source</p>
          <h1 class="intro_h1">Public code you can inspect, commit by commit.</h1>
          <p class="art_lede" data-os="lede">The tooling behind our work is open source. On Stellar we are core contributors to the official CLI and build the tools around it; some of them already serve XRPL. Each tool has its own page: what it does, what we built, where it stands and who uses it, with every figure dated. Foundations hire us to build and maintain them: see the <a class="art_related-link" href="/case-studies/stellar-development-foundation">Stellar Development Foundation case</a>.</p>
        </div>
      </div>
    </section>
    <section aria-label="In numbers" class="cs_outcomes" data-os="metrics">
      <ul class="cs_metrics" role="list">
        {metrics.map((m) => (
          <li class="cs_metric">
            <span class="cs_fig"><span>{m.figure}</span>{m.receipt && <a aria-label={`Receipt: ${m.label}`} class="cs_figmark" href={m.receipt}>✓</a>}</span>
            <span class="cs_metriclabel">{m.label}</span>
          </li>
        ))}
      </ul>
    </section>
    <section class="ab_white">
      <div class="ab_container">
        <h2 class="ab_h2">The tools</h2>
        <ul class="os_grid" data-os="tools" role="list">
          {list.map((t) => (
            <li class="os_card" id={t.id} data-os-tool={t.id}>
              <a class="os_cardlink" href={`/open-source/${t.id}`}>
                <span class="os_head">
                  <span class="os_name">{t.data.name}</span>
                  <span class="os_net">{t.data.network}</span>
                </span>
                <span class="os_cat">{t.data.category}</span>
                <span class="os_what">{t.data.summary}</span>
                {t.data.headline?.figure && (
                  <span class="os_kpi"><span class="os_kpifig">{t.data.headline.figure}</span><span class="os_kpilabel">{t.data.headline.label}</span></span>
                )}
                <span class="os_more">Read about {t.data.name} →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="ab_white" data-os="count" id="how-we-count">
      <div class="ab_container">
        <div class="ab_howgrid">
          <div class="ab_howhead">
            <h2 class="ab_h2">How we count</h2>
          </div>
          <div class="os_count">
            <p>A project counts when its public repo uses a tool in code (configuration, dependencies, imports or CLI scripts), or when its contracts use it onchain. Forks count once, and a project using several tools counts once in the total.</p>
            <p>A tool’s own repo never counts toward that tool; our other tools and our team’s own projects count like any other project. Pages that only mention a tool do not count. Code search does not index every repo, so project counts are floors, and testnet counts include our own testing.</p>
            <p>Every figure carries the date it was counted. Counts that only grow, such as downloads, calls and wallets, are as of that date.</p>
          </div>
        </div>
      </div>
    </section>
    <section data-os="contributions">
      <div class="ab_container">
        <div class="os_sthead">
          <h2 class="ab_h2">Standards and contributions</h2>
          <p class="os_stlede">Beyond our own tools: the standards we wrote and our code in SDKs, wallets and libraries, across the networks we work on.</p>
        </div>
        <div class="os_stgroups" data-os="standards">
          {contributions.map((g) => (
            <div class="os_stgroup">
              <h3 class="os_stlabel">{g.title}</h3>
              <ul class="os_stlist" role="list">
                {g.items.map((s) => (
                  <li class="os_stitem">
                    {s.href
                      ? <a class="os_stname" href={s.href}><Fragment set:html={nobr(s.name)} /><span aria-hidden="true" class="os_starrow"> ↗</span></a>
                      : <p class="os_stname" set:html={nobr(s.name)} />}
                    <p class="os_stwhat" set:html={nobr(s.what)} />
                    <p class="os_stmeta">{s.network}<span aria-hidden="true"> · </span><span class="os_ststatus">{s.status}</span></p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Cta heading="Building on Stellar or XRPL? Talk to the engineers who write the tooling." />
</BaseLayout>
<style>
  .os_grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }
  .os_card { display: flex; scroll-margin-top: 120px; }
  .os_cardlink { display: flex; flex-direction: column; gap: 14px; width: 100%; padding: 28px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-md); color: inherit; text-decoration: none; transition: border-color .2s; }
  .os_cardlink:hover { border-color: var(--deep-blue); }
  .os_cardlink:hover .os_more { color: var(--green-ink); }
  .os_head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .os_name { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 30px; line-height: 1.1; color: var(--deep-blue); }
  .os_net { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .os_cat { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--green-ink); }
  .os_what { font-size: 17px; line-height: 1.5; color: var(--ink); }
  .os_kpi { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); }
  .os_kpifig { font-size: 32px; font-weight: 500; letter-spacing: -.02em; line-height: 1; color: var(--deep-blue); }
  .os_kpilabel { font-size: 14px; color: var(--muted); }
  .os_more { font-size: 14px; font-weight: 600; color: var(--deep-blue); transition: color .2s; }
  .os_count { display: flex; flex-direction: column; gap: 14px; max-width: 640px; font-size: 16px; line-height: 1.6; color: var(--ink-2); }
  .os_count p { margin: 0; }
  .os_sthead { display: flex; flex-direction: column; gap: 16px; max-width: 720px; }
  .os_stlede { margin: 0; font-size: 17px; line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
  .os_stgroups { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 48px; }
  .os_stlabel { margin: 0; padding-bottom: 12px; border-bottom: 1px solid var(--deep-blue); font-family: inherit; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--deep-blue); }
  .os_stlist { margin: 0; padding: 0; list-style: none; }
  .os_stitem { display: flex; flex-direction: column; gap: 6px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .os_stmeta { order: -1; margin: 0; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .os_ststatus { color: var(--green-ink); }
  .os_stname { margin: 0; font-size: 18px; font-weight: 600; line-height: 1.35; color: var(--deep-blue); text-decoration: none; }
  a.os_stname:hover { color: var(--green-ink); }
  .os_starrow { color: var(--muted); font-weight: 500; }
  .os_stwhat { margin: 0; font-size: 16px; line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
  @media (min-width: 992px) {
    .os_stgroups { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 64px; }
    .os_stgroup:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .os_stgroup:last-child:nth-child(odd) .os_stlist { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 64px; }
  }
</style>
