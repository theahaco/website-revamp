---
// Generated from the Webflow page "/about". Edit freely: this file is the source now.
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamGrid from '../components/TeamGrid.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title={'About The Aha Company: blockchain engineers since 2021'} description={'12+ blockchain engineers across the United States, Europe and Brazil, founded in 2021: how we work, who we are and the roles we hold in each ecosystem.'}>
<main><section><div class="ab_introcontainer"><div class="ab_introhead"><p class="v-eyebrow page_eyebrow">About</p><h1 class="intro_h1">We build the tooling. We do the integrations.</h1><p class="art_lede" data-rv="about-lede">Founded in 2021. 12+ engineers across the United States, Europe and Brazil. Core contributors on Stellar, program partners on XRPL, integrations in progress on Canton.</p></div><figure class="ab_photo"><img alt="The Aha Company team around a table in the office" class="ab_photoimg" fetchpriority="high" height="1065" sizes="(max-width: 991px) 100vw, 1200px" src="/images/photos/team-photo-office.webp" srcset="/images/photos/team-photo-office-960.webp 960w, /images/photos/team-photo-office.webp 1600w, /images/photos/team-photo-office-2400.webp 2400w" width="1600"/><figcaption class="ab_photocaption" data-rv="about-photo-caption">The team · United States · Europe · Brazil</figcaption></figure></div></section><section class="ab_facts"><div class="ab_factscontainer"><ul class="ab_factsgrid" role="list"><li class="ab_fact" data-rv="fact-founded"><span class="v-iconbox v-iconbox--dark v-iconbox--sm ab_facticon"><Icon name="flag-banner" size={22} /></span><span class="ab_factnum">2021</span><span class="ab_factlabel">Founded</span></li><li class="ab_fact" data-rv="fact-team"><span class="v-iconbox v-iconbox--dark v-iconbox--sm ab_facticon"><Icon name="users-three" size={22} /></span><span class="ab_factnum">12+</span><span class="ab_factlabel">Engineers</span></li><li class="ab_fact" data-rv="fact-countries"><span class="v-iconbox v-iconbox--dark v-iconbox--sm ab_facticon"><Icon name="globe-hemisphere-west" size={22} /></span><span class="ab_factnum">4</span><span class="ab_factlabel">Countries: United States, France, Austria, Brazil</span></li></ul></div></section><section class="ab_white"><div class="ab_container"><div class="ab_howgrid"><div class="ab_howhead"><h2 class="ab_h2">How we work</h2><p class="art_lede">One voice for two very different rooms: a bank’s risk committee and a protocol team’s GitHub.</p></div><ul class="ab_howlist" role="list"><li class="ab_howrow"><span class="v-iconbox ab_howicon"><Icon name="phone-call" size={26} /></span><h3 class="ab_howtitle">An engineer on every call</h3><p class="ab_howbody">The first conversation is thirty minutes with someone who has shipped the kind of system you are asking about. No sales team.</p></li><li class="ab_howrow"><span class="v-iconbox ab_howicon"><Icon name="list-checks" size={26} /></span><h3 class="ab_howtitle">Milestones your team can verify</h3><p class="ab_howbody">NDA, then an MOU with the scope cut into milestones. Each one has an output you can check, on testnet, before mainnet.</p></li><li class="ab_howrow"><span class="v-iconbox ab_howicon"><Icon name="hand-palm" size={26} /></span><h3 class="ab_howtitle">We say no early</h3><p class="ab_howbody">Where an ecosystem program applies, we scope and draft the application. Where it doesn’t, or where the architecture is wrong for the network, we say so before any work starts.</p></li><li class="ab_howrow"><span class="v-iconbox ab_howicon"><Icon name="handshake" size={26} /></span><h3 class="ab_howtitle">We stay on the account</h3><p class="ab_howbody">Production surfaces questions a testnet never asks. Deployment comes with runbooks and handover, and we keep evolving the system with your team after launch.</p></li><li class="ab_howrow"><span class="v-iconbox ab_howicon"><Icon name="git-branch" size={26} /></span><h3 class="ab_howtitle">Public goods, maintained</h3><p class="ab_howbody">The tooling we build for ecosystems is open source with a quarterly proposal and review, not a one-off deliverable.</p></li></ul></div></div></section><section class="ab_team" data-ab="team" id="team"><div class="ab_container"><div class="tm_teamhead"><h2 class="ab_h2">The team</h2><p class="tm_count" data-rv="about-team-count">The core team · United States · Europe · Brazil</p></div><TeamGrid variant="about" /></div></section><section class="ab_white"><div class="ab_container"><h2 class="ab_h2">Roles we hold in the ecosystems</h2><ul class="ab_rolesgrid" role="list"><li class="ab_rolecard"><img alt="Stellar" class="ab_rolelogo" loading="lazy" src="/images/logos/logo-light-stellar.svg"/><p class="ab_rolebody"><span data-rv="about-roles">Core contributor · Stellar Community Fund reviewer · Stellar Architect Program expert · maintainer of <a class="ab_rolelink" href="/open-source/stellar-scaffold">Stellar Scaffold</a>, the <a class="ab_rolelink" href="/open-source/stellar-cli">Stellar CLI plugin system</a>, <a class="ab_rolelink" href="/open-source/stellar-registry">Stellar Registry</a>, <a class="ab_rolelink" href="/open-source/nido">Nido</a>, <a class="ab_rolelink" href="/open-source/perch">Perch</a>, <a class="ab_rolelink" href="/open-source/moonlight">Moonlight</a> and <a class="ab_rolelink" href="/open-source/tansu">Tansu</a></span></p></li><li class="ab_rolecard"><img alt="XRPL" class="ab_rolelogo" loading="lazy" src="/images/logos/logo-xrpl-transparent.webp"/><p class="ab_rolebody" data-rv="about-roles-xrpl">Ripple program partner: accelerator cohorts and hackathons, continuous work on developer experience · maintainer of <a class="ab_rolelink" href="/open-source/ghostsig">GhostSig</a></p></li><li class="ab_rolecard"><img alt="Canton" class="ab_rolelogo" loading="lazy" src="/images/logos/logo-light-canton.svg"/><p class="ab_rolebody">Integrations in progress</p></li></ul><a class="svc_casecta os_aboutlink" data-rv="about-os" href="/open-source">See the tools we build and maintain →</a></div></section><section class="footer_section"><div class="ab_officescontainer"><div class="ab_officesgrid"><div class="ab_office"><h3 class="ab_officecountry"><Icon name="map-pin" size={20} class="ab_officepin" />United States</h3><p class="ab_officeentity" data-rv="office-us">Dawning Inc. (dba The Aha Company)</p><p class="ab_officeaddr" data-rv="office-us-desc">Our company, incorporated in Delaware. It operates this site and employs our US-based engineers.</p><p class="ab_officeaddr"><span>108 W. 13th Street, Suite 100</span><br/><span>Wilmington, DE 19801</span></p></div><div class="ab_office"><h3 class="ab_officecountry"><Icon name="map-pin" size={20} class="ab_officepin" />Europe</h3><p class="ab_officeentity" data-rv="office-fr">Paris</p><p class="ab_officeaddr" data-rv="office-fr-desc">Engineers in France and Austria.</p></div><div class="ab_office"><h3 class="ab_officecountry"><Icon name="map-pin" size={20} class="ab_officepin" />Brazil</h3><p class="ab_officeentity" data-rv="office-br">São Paulo</p><p class="ab_officeaddr" data-rv="office-br-desc">Engineers in Brazil, led by Fabricius Zatti.</p></div></div></div></section></main>
<Cta heading={'Talk to an engineer, not a sales team.'} />
<style is:global>
  .ab_fact { position: relative; }
  .ab_facticon { margin-bottom: 18px; }
  li.ab_howrow { display: grid; grid-template-columns: 48px minmax(0, 1fr); column-gap: 20px; row-gap: 6px; align-items: start; }
  li.ab_howrow > .ab_howicon { grid-row: 1 / span 2; }
  li.ab_howrow > .ab_howtitle, li.ab_howrow > .ab_howbody { grid-column: 2; }
  li.ab_howrow > .ab_howtitle { align-self: end; }
  h3.ab_officecountry { display: flex; align-items: center; gap: 8px; }
  .ab_officepin { color: var(--deep-blue); --icon-tint: var(--vibrant-green); --icon-tint-opacity: .6; }
  @media (min-width: 992px) { .ab_howgrid > .ab_howhead { position: sticky; top: 120px; } }
</style>
</BaseLayout>
