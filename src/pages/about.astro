---
// About: the team photo, the figures, how we work (a calm list, no icons),
// the team, the roles we hold in each ecosystem and the offices.
// "Roles we hold in the ecosystems" follows the home band's recipe: eyebrow,
// two-tone title, short lede, one real visual (a Stellar CLI session with our
// two plugins, recorded on Stellar CLI 30.0.1 on November 5, 2026, unedited
// apart from whole lines cut at the end of an output, marked "…"), then one
// cell per network.
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamGrid from '../components/TeamGrid.astro';
import Cta from '../components/Cta.astro';
import Terminal from '../components/vx/Terminal.astro';

const how = [
  { title: 'An engineer on every call', body: 'The first conversation is thirty minutes with someone who has shipped the kind of system you are asking about. No sales team.' },
  { title: 'Milestones your team can verify', body: 'NDA, then an MOU with the scope cut into milestones. Each one has an output you can check, on testnet, before mainnet.' },
  { title: 'We say no early', body: 'Where an ecosystem program applies, we scope and draft the application. Where it doesn’t, or where the architecture is wrong for the network, we say so before any work starts.' },
  { title: 'We stay on the account', body: 'Production surfaces questions a testnet never asks. Deployment comes with runbooks and handover, and we keep evolving the system with your team after launch.' },
  { title: 'Public goods, maintained', body: 'The tooling we build for ecosystems is open source with a quarterly proposal and review, not a one-off deliverable.' },
];

// Copied from the raw captures, in run order (see the comment at the top)
const session = [
  '$ stellar --version',
  'stellar 30.0.1 (f2a7b74175c34585f3b30a1abf42a2d41cbcc390)',
  '…',
  '$ stellar plugin ls',
  'Installed Plugins:',
  '    registry',
  '    scaffold',
  '$ stellar scaffold --version',
  'stellar-scaffold 0.0.34 (92865100a50288d86552fcf30b6cd275f6f90c07)',
  '…',
  '$ stellar registry version',
  'stellar registry 0.3.0 (8311574ee53d629e8b1c1aa7c023aa91fcf2bf8b)',
  '…',
];
---
<BaseLayout title={'About The Aha Company: blockchain engineers since 2021'} description={'12+ blockchain engineers across the United States, Europe and Brazil, founded in 2021: how we work, who we are and the roles we hold in each ecosystem.'}>
<main>
  <section>
    <div class="ab_introcontainer">
      <div class="ab_introhead">
        <p class="v-eyebrow page_eyebrow">About</p>
        <h1 class="intro_h1">We build the tooling. <span class="v-soft">We do the integrations.</span></h1>
        <p class="art_lede" data-rv="about-lede">Founded in 2021. 12+ engineers across the United States, Europe and Brazil. Core contributors on Stellar, program partners on XRPL, integrations in progress on Canton.</p>
      </div>
      <figure class="ab_photo">
        <img alt="The Aha Company team around a table in the office" class="ab_photoimg" fetchpriority="high" height="1065" sizes="(max-width: 991px) 100vw, 1200px" src="/images/photos/team-photo-office.webp" srcset="/images/photos/team-photo-office-960.webp 960w, /images/photos/team-photo-office.webp 1600w, /images/photos/team-photo-office-2400.webp 2400w" width="1600" />
        <figcaption class="ab_photocaption" data-rv="about-photo-caption">The team · United States · Europe · Brazil</figcaption>
      </figure>
    </div>
  </section>

  <section aria-label="In numbers" class="ab_facts">
    <div class="ab_factscontainer">
      <ul class="ab_factsgrid" role="list">
        <li class="ab_fact" data-rv="fact-founded"><span class="ab_factnum">2021</span><span class="ab_factlabel">Founded</span></li>
        <li class="ab_fact" data-rv="fact-team"><span class="ab_factnum">12+</span><span class="ab_factlabel">Engineers</span></li>
        <li class="ab_fact" data-rv="fact-countries"><span class="ab_factnum">4</span><span class="ab_factlabel">Countries: United States, France, Austria, Brazil</span></li>
      </ul>
    </div>
  </section>

  <section aria-labelledby="ab-how" class="ab_white">
    <div class="ab_container">
      <div class="abh">
        <div class="abh_head">
          <h2 class="ab_h2 abh_h2" id="ab-how">How we work. <span class="v-soft">One voice for two very different rooms.</span></h2>
          <p class="abh_lede">A bank’s risk committee and a protocol team’s GitHub hear the same things from us.</p>
        </div>
        <ol class="abh_list" role="list">
          {how.map((h, i) => (
            <li class="abh_row">
              <span aria-hidden="true" class="abh_num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="abh_title">{h.title}</h3>
              <p class="abh_body">{h.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="ab_team" data-ab="team" id="team">
    <div class="ab_container">
      <div class="tm_teamhead">
        <h2 class="ab_h2">The team</h2>
        <p class="tm_count" data-rv="about-team-count">The core team · United States · Europe · Brazil</p>
      </div>
      <TeamGrid variant="about" />
    </div>
  </section>

  <section aria-labelledby="ab-roles" class="ab_white">
    <div class="ab_container abr">
      <div class="abr_top">
        <div class="abr_text">
          <p class="v-eyebrow">Ecosystems</p>
          <h2 class="ab_h2 abr_h2" id="ab-roles">Roles we hold in the ecosystems. <span class="v-soft">Inside the tooling and the programs.</span></h2>
          <p class="abr_lede">Our engineers wrote parts of the Stellar CLI that developers use every day, and maintain the tools around it. On XRPL, our architects mentor the teams in Ripple’s programs.</p>
        </div>
        <figure class="abr_visual">
          <Terminal compact label="A Stellar CLI session: the CLI’s version, its installed plugins, and the versions of our Scaffold and Registry plugins" lines={session} />
          <figcaption class="abr_caption">A real session, recorded on November 5, 2026: the official Stellar CLI, with the two plugins we maintain running as <code>stellar</code> subcommands.</figcaption>
        </figure>
      </div>
      <ul class="abr_cells" role="list">
        <li class="abr_cell">
          <img alt="Stellar" class="abr_logo" height="26" loading="lazy" src="/images/logos/logo-light-stellar.svg" width="106" />
          <ul class="abr_roles" data-rv="about-roles" role="list">
            <li>Core contributor</li>
            <li>Stellar Community Fund reviewer</li>
            <li>Stellar Architect Program expert</li>
            <li>Maintainer of <a class="ab_rolelink" href="/open-source/stellar-scaffold">Stellar Scaffold</a>, the <a class="ab_rolelink" href="/open-source/stellar-cli">Stellar CLI plugin system</a>, <a class="ab_rolelink" href="/open-source/stellar-registry">Stellar Registry</a>, <a class="ab_rolelink" href="/open-source/nido">Nido</a>, <a class="ab_rolelink" href="/open-source/perch">Perch</a>, <a class="ab_rolelink" href="/open-source/moonlight">Moonlight</a> and <a class="ab_rolelink" href="/open-source/tansu">Tansu</a></li>
          </ul>
        </li>
        <li class="abr_cell">
          <img alt="XRPL" class="abr_logo abr_logo--xrpl" height="80" loading="lazy" src="/images/logos/logo-xrpl-transparent.webp" width="313" />
          <ul class="abr_roles" data-rv="about-roles-xrpl" role="list">
            <li>Ripple program partner: accelerator cohorts and hackathons</li>
            <li>Continuous work on developer experience</li>
            <li>Maintainer of <a class="ab_rolelink" href="/open-source/ghostsig">GhostSig</a></li>
          </ul>
        </li>
        <li class="abr_cell">
          <img alt="Canton" class="abr_logo" height="369" loading="lazy" src="/images/logos/logo-light-canton.svg" width="1432" />
          <ul class="abr_roles" role="list">
            <li>Integrations in progress</li>
          </ul>
        </li>
      </ul>
      <a class="abr_all" data-rv="about-os" href="/open-source">See the tools we build and maintain <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="footer_section">
    <div class="ab_officescontainer">
      <div class="ab_officesgrid">
        <div class="ab_office">
          <h3 class="ab_officecountry">United States</h3>
          <p class="ab_officeentity" data-rv="office-us">Dawning Inc. (dba The Aha Company)</p>
          <p class="ab_officeaddr" data-rv="office-us-desc">Our company, incorporated in Delaware. It operates this site and employs our US-based engineers.</p>
          <p class="ab_officeaddr"><span>108 W. 13th Street, Suite 100</span><br /><span>Wilmington, DE 19801</span></p>
        </div>
        <div class="ab_office">
          <h3 class="ab_officecountry">Europe</h3>
          <p class="ab_officeentity" data-rv="office-fr">Paris</p>
          <p class="ab_officeaddr" data-rv="office-fr-desc">Engineers in France and Austria.</p>
        </div>
        <div class="ab_office">
          <h3 class="ab_officecountry">Brazil</h3>
          <p class="ab_officeentity" data-rv="office-br">São Paulo</p>
          <p class="ab_officeaddr" data-rv="office-br-desc">Engineers in Brazil, led by Fabricius Zatti.</p>
        </div>
      </div>
    </div>
  </section>
</main>
<Cta heading={'Talk to an engineer, not a sales team.'} />
</BaseLayout>

<style>
  /* How we work: a calm list, as on a bank's vendor page. The title stays in
     view while the five rows scroll by. */
  .abh { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: 64px; row-gap: 40px; align-items: start; }
  .abh_head { display: flex; flex-direction: column; gap: 20px; }
  .abh_h2 { max-width: 12em; text-wrap: balance; }
  .abh_h2 .v-soft { display: block; }
  .abh_lede { margin: 0; max-width: 26em; color: var(--ink-2); font-size: 17px; line-height: 1.55; text-wrap: pretty; }
  .abh_list { margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .abh_row { display: grid; grid-template-columns: 52px minmax(0, 1fr); row-gap: 8px; padding: 28px 0 30px; border-bottom: 1px solid var(--line); }
  .abh_num { grid-row: 1 / span 2; padding-top: 4px; color: var(--muted); font-size: 13px; font-weight: 500; line-height: 1; font-variant-numeric: tabular-nums; }
  .abh_title { grid-column: 2; margin: 0; color: var(--deep-blue); font-size: 19px; font-weight: 600; line-height: 1.3; }
  .abh_body { grid-column: 2; margin: 0; max-width: 36em; color: var(--ink-2); font-size: 16px; line-height: 1.6; text-wrap: pretty; }
  @media (min-width: 992px) { .abh_head { position: sticky; top: 120px; } }

  /* Roles: text and the session side by side, then one cell per network */
  .abr { row-gap: 0; }
  .abr_top { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 64px; row-gap: 40px; align-items: center; }
  .abr_text { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .abr_h2 { max-width: 13em; text-wrap: balance; }
  .abr_h2 .v-soft { display: block; }
  .abr_lede { margin: 0; max-width: 32em; color: var(--ink-2); font-size: 17px; line-height: 1.55; text-wrap: pretty; }
  .abr_visual { min-width: 0; margin: 0; }
  .abr_caption { margin: 14px 0 0; color: var(--muted); font-size: 14px; line-height: 1.45; text-align: left; }
  .abr_caption code { font: .92em ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--deep-blue); }

  .abr_cells { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 64px 0 0; padding: 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--line); list-style: none; }
  .abr_cell { display: flex; flex-direction: column; gap: 22px; min-width: 0; padding: 28px 28px 30px; background: var(--white); }
  .abr_logo { display: block; align-self: flex-start; width: auto; max-width: 100%; height: 26px; }
  .abr_logo--xrpl { height: 30px; margin: -2px 0; }
  .abr_roles { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .abr_roles li { position: relative; padding-left: 16px; color: var(--ink-2); font-size: 15px; line-height: 1.5; }
  .abr_roles li::before { content: ''; position: absolute; left: 0; top: .62em; width: 6px; height: 6px; border-radius: 50%; background: var(--vibrant-green); }
  .abr_roles :global(.ab_rolelink) { color: var(--deep-blue); text-decoration: underline; text-decoration-color: rgba(26, 59, 96, .35); text-underline-offset: 3px; transition: color .2s, text-decoration-color .2s; }
  .abr_roles :global(.ab_rolelink:hover) { color: var(--green-ink); text-decoration-color: currentColor; }
  .abr_all { display: inline-flex; align-items: center; align-self: flex-start; gap: 8px; min-height: 48px; margin-top: 32px; padding: 10px 24px; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); color: var(--deep-blue); font-size: 15px; font-weight: 600; line-height: 1.35; text-decoration: none; text-wrap: balance; transition: border-color .2s; }
  .abr_all:hover { border-color: var(--deep-blue); }

  @media (max-width: 991px) {
    .abh { grid-template-columns: minmax(0, 1fr); }
    .abr_top { grid-template-columns: minmax(0, 1fr); }
    .abr_visual { max-width: 640px; }
    .abr_cells { grid-template-columns: minmax(0, 1fr); margin-top: 48px; }
  }
  @media (max-width: 479px) {
    .abr_all { align-self: stretch; justify-content: center; text-align: center; }
  }
  @media (max-width: 767px) {
    .abh_row { grid-template-columns: 40px minmax(0, 1fr); padding: 24px 0 26px; }
    .abh_title { font-size: 18px; }
    .abr_cell { padding: 24px 20px 26px; gap: 18px; }
  }
  @media (pointer: coarse) {
    .abr_all { min-height: 48px; }
  }
</style>
