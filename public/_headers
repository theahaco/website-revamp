# Cloudflare Pages response headers (GitHub Pages ignores this file).
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Built CSS and JS carry a content hash in their name: cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Preview deployments on *.pages.dev must never be indexed: only theaha.co is.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
